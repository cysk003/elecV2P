<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>OpenCode.efh By elecV2</title>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <style>
    :root {
      --bk: #0d1117; --bk2: #161b22; --bk3: #1c2128;
      --fc: #e6edf3; --fc2: #7d8590; --fc3: #484f58;
      --ac: #58a6ff; --ok: #3fb950; --del: #f85149;
      --bd: #30363d; --code-bk: #0d1117;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font: 14px/1.6 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bk); color: var(--fc); height: 100vh;
      display: flex; flex-direction: column; overflow: hidden;
    }
    #app { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .header {
      display: flex; align-items: center; gap: 10px; padding: 10px 16px; position: relative;
      background: var(--bk2); border-bottom: 1px solid var(--bd); flex-shrink: 0;
    }
    .header h1 { font-size: 16px; color: var(--ac); white-space: nowrap; cursor: pointer; }
    .header h1:hover { opacity: .8; }
    .header .spacer { flex: 1; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); display: inline-block; }
    .dot.run { background: var(--ac); animation: pulse 1s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
    .header button {
      padding: 4px 10px; border-radius: 6px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc2); font-size: 12px; cursor: pointer;
    }
    .header button:hover { color: var(--fc); border-color: var(--fc3); }
    .header .mode-btn { color: var(--ac); border-color: var(--ac); }
    .header .mode-btn.run { color: var(--warn, #e0a53c); border-color: var(--warn, #e0a53c); }
    .header .dropdown-trigger { font-size: 12px; color: var(--fc2); cursor: pointer; position: relative; white-space: nowrap; }
    .header .dropdown-trigger b { color: var(--ok); }
    .header .dropdown-trigger:hover b { text-decoration: underline; }
    .header .dropdown-trigger .arr { font-size: 8px; margin-left: 2px; }
    .header .dropdown-trigger + .dropdown-trigger { margin-left: 24px; }
    .header .ver { font-size: 10px; color: var(--fc3); margin-left: 4px; white-space: nowrap; }
    .ctx {
      display: inline-flex; align-items: center; gap: 6px;
      margin-right: 12px; font-size: 11px; color: var(--fc2); white-space: nowrap;
      cursor: default; border: 1px solid var(--bd); border-radius: 8px; padding: 2px 8px;
      background: var(--bk3);
    }
    .ctx-bar { width: 56px; height: 5px; border-radius: 3px; background: var(--bd); overflow: hidden; }
    .ctx-bar i { display: block; height: 100%; background: var(--ac); border-radius: 3px; }
    .ctx-bar.warn i { background: #e3b341; }
    .ctx-bar.danger i { background: var(--del); }
    .ctx-num { font-family: 'Cascadia Code', Consolas, monospace; }
    .header .load { position: absolute; left: 50%; transform: translateX(-50%); font-size: 22px; color: var(--ac); letter-spacing: 4px; animation: loadPulse 1.2s ease-in-out infinite; }
    @keyframes loadPulse { 0%,100% { opacity: .25; } 50% { opacity: 1; } }
    #modelDropdown { left: auto; right: 0; }
    .dropdown {
      position: absolute; top: 100%; left: 0; margin-top: 4px;
      background: var(--bk2); border: 1px solid var(--bd); border-radius: 8px;
      min-width: 260px; max-height: 350px; overflow-y: auto; z-index: 200;
      box-shadow: 0 8px 24px rgba(0,0,0,.4); display: none;
    }
    .dropdown.show { display: block; }
    .dropdown .d-item {
      padding: 7px 12px; cursor: pointer; border-bottom: 1px solid var(--bd);
      transition: background .15s;
    }
    .dropdown .d-item:last-child { border-bottom: none; }
    .dropdown .d-item:hover { background: var(--bk3); }
    .dropdown .d-item.active { background: var(--bk3); border-left: 3px solid var(--ac); }
    .dropdown .d-item .d-title { font-size: 13px; color: var(--fc); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dropdown .d-item .d-sub { font-size: 10px; color: var(--fc3); }
    .dropdown .d-empty { padding: 20px; text-align: center; color: var(--fc3); font-size: 12px; }
    .dropdown .d-more { padding: 8px 12px; text-align: center; font-size: 12px; color: var(--ac); cursor: pointer; border-top: 1px solid var(--bd); }
    .dropdown .d-more:hover { background: var(--bk3); }
    .dropdown .model-foot {
      display: flex; align-items: center; justify-content: space-between;
      padding: 8px 12px; border-top: 1px solid var(--bd); position: sticky; bottom: 0;
      background: var(--bk2);
    }
    .dropdown .model-count { font-size: 11px; color: var(--fc3); }
    .dropdown .model-refresh { font-size: 12px; color: var(--ac); cursor: pointer; }
    .dropdown .model-refresh:hover { text-decoration: underline; }
    .dropdown .model-refresh.busy { color: var(--fc3); cursor: default; text-decoration: none; }
    .messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; min-height: 0; }
    .welcome { color: var(--fc2); text-align: center; margin: auto; font-size: 15px; line-height: 2; }
    .welcome b { color: var(--ac); }
    .msg-loading {
      color: var(--fc2); text-align: center; margin: auto; font-size: 14px;
      display: flex; flex-direction: column; align-items: center; gap: 10px;
    }
    .msg-loading .spin {
      width: 26px; height: 26px; border: 3px solid var(--bd);
      border-top-color: var(--ac); border-radius: 50%;
      animation: installSpin .8s linear infinite;
    }
    .msg { max-width: 85%; padding: 10px 14px; border-radius: 10px; line-height: 1.7; word-break: break-word; font-size: 14px; }
    .msg.user { align-self: flex-end; background: var(--ac); color: #000; border-bottom-right-radius: 2px; }
    .msg.assistant { align-self: flex-start; background: var(--bk2); border: 1px solid var(--bd); border-bottom-left-radius: 2px; }
    .msg.error { align-self: flex-start; background: #2d1215; border: 1px solid #5b2a2e; color: var(--del); }
    .msg .meta { font-size: 11px; color: var(--fc3); margin-top: 8px; border-top: 1px solid var(--bd); padding-top: 6px; }
    .msg.user .meta { color: rgba(0,0,0,.4); }
    .msg.assistant p { margin: .4em 0; }
    .msg.assistant p:first-child { margin-top: 0; }
    .msg.assistant p:last-child { margin-bottom: 0; }
    .msg.assistant ul, .msg.assistant ol { padding-left: 1.5em; margin: .4em 0; }
    .msg.assistant blockquote { border-left: 3px solid var(--bd); padding-left: 10px; color: var(--fc2); margin: .5em 0; }
    .msg.assistant h1, .msg.assistant h2, .msg.assistant h3, .msg.assistant h4 { margin: .6em 0 .3em; line-height: 1.3; }
    .msg.assistant h1 { font-size: 1.3em; } .msg.assistant h2 { font-size: 1.15em; } .msg.assistant h3 { font-size: 1.05em; }
    .msg.assistant table { border-collapse: collapse; margin: .5em 0; width: 100%; }
    .msg.assistant th, .msg.assistant td { border: 1px solid var(--bd); padding: 4px 8px; font-size: 13px; }
    .msg.assistant th { background: var(--bk3); }
    .msg.assistant a { color: var(--ac); text-decoration: none; }
    .msg.assistant a:hover { text-decoration: underline; }
    .msg.assistant hr { border: none; border-top: 1px solid var(--bd); margin: .6em 0; }
    .msg.assistant img { max-width: 100%; border-radius: 6px; }
    .msg.assistant code { font-family: 'Cascadia Code','Fira Code','Consolas',monospace; font-size: 13px; }
    .msg.assistant :not(pre) > code { background: var(--bk3); padding: 1px 5px; border-radius: 4px; }
    .msg.assistant pre {
      background: var(--code-bk); padding: 12px; border-radius: 6px; overflow-x: auto;
      margin: .5em 0; border: 1px solid var(--bd); position: relative;
    }
    .msg.assistant pre code { background: none; padding: 0; font-size: 13px; line-height: 1.5; }
    .msg.assistant .code-lang {
      position: absolute; top: 4px; right: 8px; font-size: 11px; color: var(--fc3);
      pointer-events: none; text-transform: uppercase;
    }
    .msg .ref {
      font-size: 12px; color: var(--fc); border-left: 2px solid var(--ac);
      padding: 2px 0 2px 10px; margin: 3px 0;
      font-family: 'Cascadia Code','Fira Code','Consolas','Courier New',monospace;
      line-height: 1.6; background: rgba(255,255,255,.04);
    }
    .msg .ref.tool { border-left-color: #f0b; }
    .msg .ref.cmd { border-left-color: #0c8; }
    .msg .ref.info { border-left-color: #4af; }
    .msg .ref.edit { border-left-color: #f80; }
    .msg .ref.act { border-left-color: #fd0; }
    .msg .ref.reasoning { border-left-color: #a78bfa; font-style: italic; }
    .msg .ref.question { border-left-color: #fa0; white-space: pre-wrap; }
    .msg .ref.permission { border-left-color: #e94; white-space: pre-wrap; }
    .msg .ref.answer { border-left-color: #0c8; white-space: pre-wrap; }
    .msg .tool-out {
      font-size: 12px; color: var(--fc2); white-space: pre-wrap; word-break: break-all;
      font-family: 'Cascadia Code','Fira Code','Consolas','Courier New',monospace;
      background: rgba(255,255,255,.03); border: 1px solid var(--bd); border-radius: 6px;
      padding: 6px 10px; margin: 4px 0; line-height: 1.5; max-height: 260px; overflow-y: auto;
    }
    .msg .stream-text { white-space: pre-wrap; word-break: break-word; line-height: 1.7; }
    .stream-par.reasoning { color: #a78bfa; font-style: italic; opacity: .75; font-size: 13px; }
    .stream-par.compact { color: #93c5fd; font-size: 13px; }
    .cursor { display: inline-block; width: 7px; height: 16px; background: var(--ac); animation: blink .7s infinite; vertical-align: text-bottom; margin-left: 2px; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
    .reasoning { margin-bottom: 8px; }
    .reasoning summary {
      font-size: 12px; color: var(--fc2); cursor: pointer; user-select: none;
      padding: 2px 0; list-style: none; display: flex; align-items: center; gap: 4px;
    }
    .reasoning[open] summary { padding-bottom: 4px; }
    .reasoning summary::before { content: '> '; color: var(--fc3); font-family: monospace; }
    .reasoning[open] summary::before { content: 'v '; }
    .reasoning-body {
      font-size: 12px; color: var(--fc2); background: var(--bk3);
      padding: 8px 10px; border-radius: 6px; margin-top: 4px; line-height: 1.5;
      white-space: pre-wrap; font-family: 'Cascadia Code','Fira Code','Consolas',monospace;
      max-height: 300px; overflow-y: auto;
    }
    .overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 99;
      opacity: 0; pointer-events: none; transition: opacity .25s;
    }
    .overlay.show { opacity: 1; pointer-events: auto; }
    .session-panel {
      position: fixed; left: -320px; top: 0; bottom: 0; width: 300px;
      background: var(--bk2); border-right: 1px solid var(--bd);
      transition: left .25s; z-index: 100; display: flex; flex-direction: column;
    }
    .session-panel.open { left: 0; }
    .session-panel-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px; border-bottom: 1px solid var(--bd); flex-shrink: 0;
    }
    .session-panel-header span { font-weight: bold; color: var(--ac); font-size: 15px; }
    .session-panel-header button {
      background: none; border: none; color: var(--fc2); cursor: pointer;
      font-size: 18px; padding: 2px 6px; border-radius: 4px;
    }
    .session-panel-header button:hover { background: var(--bk3); color: var(--fc); }
    .session-list { flex: 1; overflow-y: auto; padding: 8px; }
    .session-item {
      padding: 10px 12px; border-radius: 8px; cursor: pointer; margin-bottom: 4px;
      border: 1px solid transparent; transition: all .15s; position: relative;
    }
    .session-item:hover { background: var(--bk3); border-color: var(--bd); }
    .session-item.active { background: var(--bk3); border-color: var(--ac); }
    .session-item .s-time { font-size: 11px; color: var(--fc3); }
    .session-item .s-prompt { font-size: 13px; color: var(--fc); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .session-item .s-preview { font-size: 12px; color: var(--fc2); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .session-item .s-del {
      position: absolute; top: 8px; right: 8px; font-size: 11px; color: var(--fc3);
      cursor: pointer; opacity: 0; padding: 2px 6px; border-radius: 4px; transition: all .15s;
    }
    .session-item:hover .s-del { opacity: 1; }
    .session-item .s-del:hover { background: var(--del); color: #fff; }
    .session-empty {
      text-align: center; color: var(--fc3); padding: 40px 20px; font-size: 13px;
    }
    .section-label {
      font-size: 11px; color: var(--fc3); padding: 4px 12px 2px; margin-top: 4px;
    }
    .input-bar {
      display: flex; gap: 8px; padding: 12px 16px;
      background: var(--bk2); border-top: 1px solid var(--bd); flex-shrink: 0;
    }
    .input-bar textarea {
      flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc); font-family: inherit; font-size: 14px;
      resize: none; outline: none; min-height: 42px; max-height: 160px;
    }
    .input-bar textarea::placeholder { color: var(--fc3); }
    .input-bar textarea:focus { border-color: var(--ac); }
    .input-bar button {
      padding: 0 18px; border: none; border-radius: 8px;
      background: var(--ac); color: #000; font-weight: bold; font-size: 14px;
      cursor: pointer; flex-shrink: 0;
    }
    .input-bar button:disabled { opacity: .4; cursor: not-allowed; }
    .cmd-wrap { position: relative; flex-shrink: 0; }
    .cmd-dropdown {
      position: absolute; left: 16px; right: 16px; bottom: calc(100% + 4px);
      background: var(--bk2); border: 1px solid var(--bd); border-radius: 10px;
      box-shadow: 0 6px 24px rgba(0,0,0,.35); max-height: 220px; overflow-y: auto; z-index: 50;
    }
    .cmd-item {
      display: flex; align-items: baseline; gap: 8px; padding: 8px 12px; cursor: pointer;
    }
    .cmd-item + .cmd-item { border-top: 1px solid var(--bd); }
    .cmd-item.active, .cmd-item:hover { background: var(--bk3); }
    .cmd-item .name { color: var(--ac); font-weight: bold; font-family: monospace; flex-shrink: 0; }
    .cmd-item .desc { color: var(--fc2); font-size: 12px; word-break: break-all; }
    .install-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: var(--bk); display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 16px;
    }
    .install-overlay .title { font-size: 18px; color: var(--fc); }
    .install-overlay .sub { font-size: 12px; color: var(--fc2); max-width: 80%; word-break: break-all; }
    .install-overlay .cmd {
      font-family: 'Cascadia Code', Consolas, monospace; font-size: 12px; color: var(--ac);
      background: rgba(88,166,255,.08); border: 1px solid rgba(88,166,255,.35);
      border-radius: 6px; padding: 6px 10px; max-width: 80%; width: 640px;
      word-break: break-all; white-space: pre-wrap;
    }
    .install-overlay .log {
      max-width: 80%; width: 640px; max-height: 280px; overflow-y: auto;
      background: var(--bk2); border: 1px solid var(--bd); border-radius: 6px;
      padding: 10px 12px; font-family: monospace; font-size: 11px; line-height: 1.5;
      color: var(--fc2); text-align: left; white-space: pre-wrap; word-break: break-all;
    }
    .install-overlay .spin {
      width: 32px; height: 32px; border: 3px solid var(--bd);
      border-top-color: var(--ac); border-radius: 50%;
      animation: installSpin .8s linear infinite;
    }
    .install-overlay .err { color: var(--del); font-size: 14px; max-width: 80%; word-break: break-all; }
    .install-overlay button {
      padding: 8px 20px; border: 1px solid var(--bd); border-radius: 6px;
      background: var(--bk3); color: var(--fc); font-size: 13px; cursor: pointer;
    }
    .install-overlay button:hover { background: var(--bk2); }
    @keyframes installSpin { to { transform: rotate(360deg) } }
    .login-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: var(--bk); display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 14px; padding: 24px;
    }
    .login-overlay .title { font-size: 18px; color: var(--fc); }
    .login-overlay .sub { font-size: 12px; color: var(--fc2); max-width: 80%; word-break: break-all; text-align: center; }
    .login-select, .login-input {
      width: 480px; max-width: 90%; padding: 10px 12px; border-radius: 8px;
      border: 1px solid var(--bd); background: var(--bk3); color: var(--fc);
      font-size: 14px; outline: none;
    }
    .login-select:focus, .login-input:focus { border-color: var(--ac); }
    .login-tip { font-size: 11px; color: var(--fc3); max-width: 80%; word-break: break-all; text-align: center; }
    .login-err { color: var(--del); font-size: 13px; max-width: 80%; word-break: break-all; text-align: center; }
    .login-actions { display: flex; gap: 10px; }
    .login-actions button {
      padding: 8px 20px; border: 1px solid var(--bd); border-radius: 6px;
      background: var(--bk3); color: var(--fc); font-size: 13px; cursor: pointer;
    }
    .login-actions button:first-child { background: var(--ac); color: #000; border-color: var(--ac); font-weight: bold; }
    .login-actions button:hover { filter: brightness(1.1); }
    .login-actions button:disabled { opacity: .5; cursor: not-allowed; }
    .mode-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: var(--bk); display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 12px; padding: 24px;
    }
    .mode-overlay .title { font-size: 18px; color: var(--fc); }
    .mode-overlay .sub { font-size: 12px; color: var(--fc3); }
    .mode-overlay .mode-item {
      width: 520px; max-width: 90%; padding: 12px 16px; border-radius: 8px;
      border: 1px solid var(--bd); background: var(--bk2); text-align: left;
    }
    .mode-overlay .mode-item.cur { border-color: var(--ac); }
    .mode-overlay .m-name { font-size: 14px; color: var(--fc); font-weight: bold; }
    .mode-overlay .m-name .m-cur { font-size: 11px; color: var(--ac); font-weight: normal; margin-left: 6px; }
    .mode-overlay .m-desc { font-size: 12px; color: var(--fc2); margin-top: 4px; line-height: 1.6; }
    .mode-actions { display: flex; gap: 10px; }
    .mode-actions button {
      padding: 8px 20px; border: 1px solid var(--bd); border-radius: 6px;
      background: var(--bk3); color: var(--fc); font-size: 13px; cursor: pointer;
    }
    .mode-actions button:first-child { background: var(--ac); color: #000; border-color: var(--ac); font-weight: bold; }
    .mode-actions button:hover { filter: brightness(1.1); }
    .mode-actions button:disabled { opacity: .5; cursor: not-allowed; }
    .notify {
      position: fixed; bottom: 68px; left: 50%; transform: translateX(-50%);
      padding: 6px 14px; border-radius: 6px; font-size: 12px; z-index: 9998;
      background: var(--ok); color: #000; opacity: 0; transition: opacity .25s;
      pointer-events: none; white-space: nowrap;
    }
    .notify.err { background: var(--del); color: #fff; }
    .notify.show { opacity: 1; }
    .todo-panel {
      flex-shrink: 0; max-height: 140px; overflow-y: auto;
      background: var(--bk2); border-top: 1px solid var(--bd);
      padding: 8px 16px; font-size: 12px; color: var(--fc2);
    }
    .todo-panel .todo-head { font-size: 11px; color: var(--fc3); margin-bottom: 4px; }
    .todo-item { padding: 2px 0; }
    .todo-item .td { color: var(--fc3); margin-right: 6px; }
    .todo-item .do { color: var(--ac); margin-right: 6px; }
    .todo-item .done { text-decoration: line-through; color: var(--fc3); }
    .stream-par.err-text { color: var(--del); }
    .stream-par.err-text pre, .stream-par.err-text code { color: var(--del); }
    .msg .meta.ok { color: var(--ok); }
    .msg .meta.err { color: var(--del); }
    .question-panel {
      flex-shrink: 0; background: var(--bk2); border-top: 1px solid var(--bd);
      border-left: 3px solid #fa0; padding: 10px 16px; max-height: 45%; overflow-y: auto;
    }
    .question-panel .q-panel-head { font-size: 11px; color: var(--ac); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 8px; }
    .question-panel .q-item { margin-bottom: 12px; }
    .question-panel .q-header { font-size: 11px; color: var(--ac); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 2px; }
    .question-panel .q-text { font-size: 14px; color: var(--fc); margin: 2px 0 8px; }
    .q-opt {
      display: flex; align-items: center; gap: 8px; padding: 8px 10px;
      border: 1px solid var(--bd); border-radius: 8px; cursor: pointer;
      margin-bottom: 6px; background: var(--bk3); transition: all .15s;
    }
    .q-opt:hover { border-color: var(--ac); }
    .q-opt.sel { border-color: var(--ac); background: rgba(88,166,255,.12); }
    .q-opt .q-check {
      width: 16px; height: 16px; border-radius: 4px; border: 1px solid var(--fc3);
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      font-size: 11px; color: #000;
    }
    .q-opt.sel .q-check { background: var(--ac); border-color: var(--ac); }
    .q-opt .q-label { font-weight: bold; color: var(--fc); }
    .q-opt .q-desc { color: var(--fc2); font-size: 12px; }
    .q-custom { display: flex; gap: 8px; margin: 6px 0; }
    .q-custom input {
      flex: 1; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc); font-size: 13px; outline: none;
    }
    .q-custom input:focus { border-color: var(--ac); }
    .q-actions { display: flex; gap: 8px; margin-top: 8px; }
    .q-actions button {
      padding: 8px 18px; border-radius: 8px; cursor: pointer; font-size: 13px;
    }
    .q-submit { background: var(--ac); color: #000; font-weight: bold; border: 1px solid var(--ac); }
    .q-submit:disabled { opacity: .5; cursor: not-allowed; }
    .q-reject { background: var(--bk3); color: var(--fc2); border: 1px solid var(--bd); }
    .q-reject:hover { color: var(--fc); border-color: var(--fc3); }
    .permission-panel {
      flex-shrink: 0; background: var(--bk2); border-top: 1px solid var(--bd);
      padding: 12px 16px; max-height: 45%; overflow-y: auto;
    }
    .permission-panel .p-header {
      font-size: 11px; color: var(--ac); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 2px;
    }
    .permission-panel .p-action { font-size: 14px; font-weight: bold; color: var(--fc); margin: 2px 0 8px; word-break: break-all; }
    .permission-panel .p-res {
      display: flex; align-items: flex-start; gap: 8px; padding: 7px 10px;
      border: 1px solid var(--bd); border-radius: 8px; margin-bottom: 5px;
      background: var(--bk3); font-size: 12px; color: var(--fc2); word-break: break-all;
    }
    .permission-panel .p-res::before { content: '▸'; color: var(--ac); flex-shrink: 0; }
    .p-actions { display: flex; gap: 8px; margin-top: 10px; }
    .p-actions button { padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 13px; flex: 1; }
    .p-actions button:disabled { opacity: .5; cursor: not-allowed; }
    .p-once { background: var(--ac); color: #000; font-weight: bold; border: 1px solid var(--ac); }
    .p-always { background: var(--bk3); color: var(--fc); border: 1px solid var(--fc3); }
    .p-always:hover { border-color: var(--ac); color: var(--ac); }
    .p-reject { background: var(--bk3); color: var(--del); border: 1px solid var(--del); }
    .p-reject:hover { background: rgba(248,81,73,.1); }
  </style>
</head>
<body>

<div id="app">
  <div class="install-overlay" v-if="installOverlay">
    <div class="spin" v-if="!installErr"></div>
    <div class="title">{{ installErr ? 'Install opencode failed' : 'Installing opencode...' }}</div>
    <div class="cmd" v-if="installCmd">$ {{ installCmd }}</div>
    <div class="log" ref="installLog">
      <div v-for="(l, li) in installLog" :key="li">{{ l }}</div>
      <span v-if="!installLog.length" style="color:var(--fc3)">{{ installProgress }}</span>
    </div>
    <div class="err" v-if="installErr">{{ installErr }}</div>
    <button v-if="installErr" @click="retryInstall" :disabled="installBusy">{{ installBusy ? 'Retrying...' : 'Retry' }}</button>
  </div>

  <div class="login-overlay" v-if="loginOverlay">
    <div class="title">Login with API Key</div>
    <div class="sub" v-if="loginConnected.length">Currently connected: {{ loginConnected.join(', ') }}</div>
    <div class="sub" v-else>No model provider connected yet. Enter an API key to start using models.</div>
    <select class="login-select" v-model="loginProvider">
      <option v-for="p in loginProviders" :key="p.id" :value="p.id">{{ p.name || p.id }}{{ p.hint ? ' — ' + p.hint : '' }}</option>
    </select>
    <input class="login-input" type="password" v-model="loginKey" placeholder="Paste your API key here" @keydown.enter.prevent="submitLogin" spellcheck="false" autocomplete="off">
    <div class="login-tip" v-if="loginProvider==='opencode'">OpenCode Zen token — the free models (big-pickle etc.) work with it. Get your token at opencode.ai/auth, then paste it here.</div>
    <div class="login-err" v-if="loginErr">{{ loginErr }}</div>
    <div class="login-actions">
      <button @click="submitLogin" :disabled="loginBusy">{{ loginBusy ? 'Saving...' : 'Login' }}</button>
      <button @click="loginOverlay=false" :disabled="loginBusy">Cancel</button>
    </div>
  </div>

  <div class="mode-overlay" v-if="modeOverlay">
    <div class="title">Switch OpenCode run mode</div>
    <div class="sub">Current mode: {{ runMode }}</div>
    <div class="mode-item" :class="{cur: runMode==='serve'}">
      <div class="m-name">serve<span class="m-cur" v-if="runMode==='serve'">(current)</span></div>
      <div class="m-desc">Resident background service (<code>opencode service</code>, dynamic port). Streaming responses, session history and context bar available. Uses extra memory (~100MB+).</div>
    </div>
    <div class="mode-item" :class="{cur: runMode==='run'}">
      <div class="m-name">run<span class="m-cur" v-if="runMode==='run'">(current)</span></div>
      <div class="m-desc">One-shot per message (<code>opencode run</code>). No resident server, minimal memory. No session history / context bar while in this mode.</div>
    </div>
    <div class="mode-actions">
      <button @click="applyRunMode()" :disabled="modeBusy">{{ modeBusy ? 'Switching...' : 'Switch to ' + (runMode === 'run' ? 'serve' : 'run') }}</button>
      <button @click="modeOverlay=false" :disabled="modeBusy">Cancel</button>
    </div>
  </div>

  <div class="notify" :class="{show: notifyShow, err: notifyType==='err'}">{{ notifyMsg }}</div>

  <div class="overlay" :class="{show: sessionPanelOpen}" @click="sessionPanelOpen=false"></div>

  <div class="session-panel" :class="{open: sessionPanelOpen}">
    <div class="session-panel-header">
      <span>Session History</span>
      <button @click="sessionPanelOpen=false">x</button>
    </div>
    <div class="session-list">
      <template v-if="pinnedSessions.length">
        <div class="section-label">PINNED</div>
        <div v-for="s in pinnedSessions" :key="'p'+s.id" class="session-item"
             :class="{active: s.id===sessionId}" :style="{opacity: deleting[s.id] ? .4 : 1}" @click="selectSession(s.id)">
          <span class="s-del" @click.stop="deleteLocalSession(s.id)" title="Delete">x</span>
          <div class="s-time">{{ fmtTime(s.timestamp) }}</div>
          <div class="s-prompt">{{ (s.prompt||'').substring(0,50) }}</div>
          <div class="s-preview">{{ (s.preview||'').substring(0,60) }}</div>
        </div>
      </template>
      <template v-if="sessions.length">
        <div class="section-label">Opencode</div>
        <div v-for="s in sessions" :key="'o'+s.id" class="session-item"
             :class="{active: s.id===sessionId}" :style="{opacity: deleting[s.id] ? .4 : 1}" @click="selectSession(s.id)">
          <span class="s-del" @click.stop="deleteOCSession(s.id)" title="Delete">x</span>
          <div class="s-time">{{ fmtTime(s.updated||s.created) }}</div>
          <div class="s-prompt">{{ (s.title||'').substring(0,50) }}</div>
          <div class="s-preview" style="font-size:11px;color:var(--fc3)">{{ s.id }}</div>
        </div>
      </template>
      <div v-if="!pinnedSessions.length && !sessions.length" class="session-empty">No sessions yet.<br>Send a message to start one.</div>
    </div>
  </div>

  <div class="header">
    <h1 @click="sessionPanelOpen=true" title="Open sessions">OpenCode</h1>
    <span class="dot" :class="{run: busy}"></span>
    <span class="load" v-if="loading">&#8226; &#8226; &#8226;</span>
    <span class="ver">{{ ocVersion }}</span>
    <span class="dropdown-trigger" @click.stop="toggleDropdown('session')" title="Click to select session">
      <b>{{ sessionLabel }}</b> <span class="arr">&#9660;</span>
      <div class="dropdown" :class="{show: dropdown==='session'}" @click.stop>
        <template v-if="sessionDropdownList.length">
          <div v-for="s in sessionDropdownList" :key="s.id" class="d-item" :class="{active: s.id===sessionId}" @click="selectSession(s.id)">
            <div class="d-title">{{ sessionTitle(s).substring(0,50) }}</div>
            <div class="d-sub">{{ s.id.slice(0,16) }}...</div>
          </div>
          <div class="d-more" @click="viewAll">View all {{ totalSessions }} sessions &rarr;</div>
        </template>
        <div v-else class="d-empty">No sessions yet</div>
      </div>
    </span>
    <span class="dropdown-trigger" @click.stop="toggleDropdown('model')" title="Click to select model">
      <span>{{ currentModel || 'auto' }}</span> <span class="arr">&#9660;</span>
      <div class="dropdown" id="modelDropdown" :class="{show: dropdown==='model'}" @click.stop>
        <div class="d-item" :class="{active: !currentModel}" @click="selectModel('')">
          <div class="d-title">auto</div><div class="d-sub">default model</div>
        </div>
        <div v-if="!cleanModels.length" class="d-item" :class="{active: currentModel==='opencode'}" @click="selectModel('opencode')">
          <div class="d-title">opencode — OpenCode Zen</div><div class="d-sub">default · free zen models (big-pickle etc.)</div>
        </div>
        <div v-for="m in cleanModels" :key="m" class="d-item" :class="{active: m===currentModel}" @click="selectModel(m)">
          <div class="d-title">{{ m }}</div>
        </div>
        <div class="model-foot">
          <span class="model-count">{{ cleanModels.length }} models</span>
          <span class="model-refresh" :class="{busy: modelLoading}" @click="refreshModels" title="Re-fetch model list">{{ modelLoading ? '刷新中…' : '刷新' }}</span>
        </div>
      </div>
    </span>
    <div class="spacer"></div>
    <span class="ctx" v-if="ctxLimit" :title="ctxUsed + ' / ' + ctxLimit + ' tokens'">
      <span class="ctx-bar" :class="{ warn: ctxPct >= 80 && ctxPct < 95, danger: ctxPct >= 95 }"><i :style="ctxStyle"></i></span>
      <span class="ctx-num">{{ ctxLabel }} · {{ ctxPct }}%</span>
    </span>
    <button class="mode-btn" :class="{run: runMode==='run'}" @click="toggleRunMode()" :title="runMode==='run' ? 'opencode run mode — one-shot per message, no resident server' : 'opencode serve mode — resident server, falls back to run'">{{ runMode === 'run' ? 'run' : 'serve' }}</button>
    <button @click="openLogin()" title="Login with an API key">key</button>
    <button @click="compactChat()">compact</button>
  </div>

  <div class="messages" ref="messagesEl">
    <div class="msg-loading" v-if="switching"><span class="spin"></span> Loading session...</div>
    <template v-else>
    <div class="welcome" v-if="!messages.length"><b>OpenCode AI Chat</b><br>Streaming via SSE<br>Click title to view sessions</div>
    <div v-for="(m, mi) in messages" :key="mi" :class="['msg', m.role]">
      <template v-if="m.role === 'user'">{{ m.content }}</template>
      <template v-else>
        <div v-for="(p, pi) in m.parts" :key="pi">
          <div v-if="p.t === 'ref'" :class="['ref', p.cls || refClass(p.c)]">{{ p.c }}</div>
          <pre v-else-if="p.t === 'out'" class="tool-out" v-html="renderOut(p.c)"></pre>
          <template v-else-if="p.t === 'text'">
            <div v-for="(v, vi) in mdViews(p, m.streaming)" :key="vi" class="stream-par" :class="p.cls || ''">
              <pre v-if="v.plain" class="stream-text">{{ v.text }}</pre>
              <div v-else v-html="v.html"></div>
            </div>
          </template>
        </div>
        <span class="cursor" v-if="m.streaming"></span>
        <div class="meta" :class="m.errored ? 'err' : 'ok'" v-if="m.meta">{{ m.meta }}</div>
      </template>
    </div>
    </template>
  </div>

  <div class="todo-panel" v-if="todos.length">
    <div class="todo-head">TODO</div>
    <div v-for="(t, ti) in todos" :key="ti" class="todo-item">
      <span class="td">{{ t.status==='completed' ? '✓' : t.status==='in_progress' ? '◐' : '○' }}</span>
      <span :class="{done: t.status==='completed'}">{{ t.content }}</span>
    </div>
  </div>

  <div class="question-panel" v-if="question">
    <div class="q-panel-head">❓ Question</div>
    <div v-for="(q, qi) in question.questions" :key="qi" class="q-item">
      <div class="q-header">{{ q.header || 'Question' }}</div>
      <div class="q-text">{{ q.question }}</div>
      <div v-for="(opt, oi) in q.options" :key="oi" class="q-opt"
           :class="{sel: qSel[qi] && qSel[qi].indexOf(opt.label) >= 0}" @click="qToggle(qi, opt.label)">
        <span class="q-check">{{ qSel[qi] && qSel[qi].indexOf(opt.label) >= 0 ? '✓' : '' }}</span>
        <span class="q-label">{{ opt.label }}</span>
        <span class="q-desc">{{ opt.description }}</span>
      </div>
      <div class="q-custom" v-if="q.custom !== false">
        <input type="text" v-model="qCustom[qi]" placeholder="Type a custom answer..." @keydown.enter.prevent="qSubmit">
      </div>
    </div>
    <div class="q-actions">
      <button class="q-submit" @click="qSubmit" :disabled="qSubmitting">Submit</button>
      <button class="q-reject" @click="qReject">Dismiss</button>
    </div>
  </div>

  <div class="permission-panel" v-if="permission">
    <div class="p-header">Permission required</div>
    <div class="p-action">{{ permission.action }}</div>
    <div v-for="(r, ri) in permission.resources" :key="ri" class="p-res">{{ r }}</div>
    <div class="p-actions">
      <button class="p-once" @click="permissionReply('once')" :disabled="permissionSubmitting">Allow once</button>
      <button class="p-always" @click="permissionReply('always')" :disabled="permissionSubmitting">Always allow</button>
      <button class="p-reject" @click="permissionReply('reject')" :disabled="permissionSubmitting">Reject</button>
    </div>
  </div>

  <div class="cmd-wrap">
    <div class="cmd-dropdown" v-if="cmdOpen && cmdFiltered.length">
      <div class="cmd-item" v-for="(c, ci) in cmdFiltered" :key="c.name" :class="{active: ci === cmdIdx}" @mousedown.prevent="pickCmd(c)">
        <span class="name">/{{ c.name }}</span>
        <span class="desc">{{ c.description }}</span>
      </div>
    </div>
    <div class="input-bar">
      <textarea ref="inputEl" rows="1" placeholder="Type a message... (Enter to send, Ctrl+Enter for newline)" v-model="inputText" @input="onInput" @keydown="onKey"></textarea>
      <button v-if="busy" @click="stop()">Stop</button>
      <button @click="send()" :disabled="busy">Send</button>
    </div>
  </div>
</div>

<script>
  let _inited = false
  const installId = Date.now() + '-' + Math.random().toString(36).slice(2, 8)
  let notifyTimer = null
  const blockCache = new Map()
  const BLOCK_CACHE_MAX = 400
  const STREAM_PARSE_MAX = 4000

  // 单条消息自身的 token 用量：完整上下文快照减去复用缓存 cache.read。
  // 与 OpenCode TUI 的 per-step "new" 口径一致；不是 session 累计，也不是右上角 ctx 总量。
  const msgTokenUsed = (tk) => {
    if (!tk) return 0
    if (tk.total != null) return Number(tk.total) || 0
    const total = (Number(tk.input) || 0) + (Number(tk.output) || 0) + (Number(tk.reasoning) || 0) + ((tk.cache && Number(tk.cache.read)) || 0) + ((tk.cache && Number(tk.cache.write)) || 0)
    const cached = (tk.cache && Number(tk.cache.read)) || 0
    return Math.max(0, total - cached)
  }

  // ANSI 转 HTML，逻辑同 utils/ansi.js（供工具输出带色渲染）
  const ANSI_MAX = 500000
  const ANSI_COLORS = [
    '#0c0c0c', '#c50f1f', '#13a10e', '#c19c00', '#0037da', '#881798', '#3a96dd', '#cccccc',
    '#767676', '#e74856', '#16c60c', '#f9f1a5', '#3b78ff', '#b4009e', '#61d6d6', '#f2f2f2',
  ]
  const ANSI_C256 = ['00', '5f', '87', 'af', 'd7', 'ff']
  for (let x = 16; x < 232; x++) {
    ANSI_COLORS.push((x - 16).toString(6).padStart(3, '0').split('').reduce((a, c) => a + ANSI_C256[c], '#'))
  }
  ANSI_COLORS.push.apply(ANSI_COLORS, ['#080808', '#121212', '#1c1c1c', '#262626', '#303030', '#3a3a3a', '#444444', '#4e4e4e', '#585858', '#626262', '#6c6c6c', '#767676', '#808080', '#8a8a8a', '#949494', '#9e9e9e', '#a8a8a8', '#b2b2b2', '#bcbcbc', '#c6c6c6', '#d0d0d0', '#dadada', '#e4e4e4', '#eeeeee'])
  const ANSI_MAP = new Map([
    ['0', ''], ['1', 'font-weight:bold;'], ['2', 'opacity:.5;'], ['3', 'font-style:italic;'],
    ['4', 'text-decoration:underline;'], ['5', ''], ['7', 'color:#0c0c0c;background-color:#767676;'],
    ['8', 'display:none;'], ['9', 'text-decoration:line-through;'],
    ['30', 'color:' + ANSI_COLORS[0] + ';'], ['90', 'color:' + ANSI_COLORS[8] + ';'],
    ['31', 'color:' + ANSI_COLORS[1] + ';'], ['91', 'color:' + ANSI_COLORS[9] + ';'],
    ['32', 'color:' + ANSI_COLORS[2] + ';'], ['92', 'color:' + ANSI_COLORS[10] + ';'],
    ['33', 'color:' + ANSI_COLORS[3] + ';'], ['93', 'color:' + ANSI_COLORS[11] + ';'],
    ['34', 'color:' + ANSI_COLORS[4] + ';'], ['94', 'color:' + ANSI_COLORS[12] + ';'],
    ['35', 'color:' + ANSI_COLORS[5] + ';'], ['95', 'color:' + ANSI_COLORS[13] + ';'],
    ['36', 'color:' + ANSI_COLORS[6] + ';'], ['96', 'color:' + ANSI_COLORS[14] + ';'],
    ['37', 'color:' + ANSI_COLORS[7] + ';'], ['97', 'color:' + ANSI_COLORS[15] + ';'],
    ['40', 'background-color:' + ANSI_COLORS[0] + ';'], ['100', 'background-color:' + ANSI_COLORS[8] + ';'],
    ['41', 'background-color:' + ANSI_COLORS[1] + ';'], ['101', 'background-color:' + ANSI_COLORS[9] + ';'],
    ['42', 'background-color:' + ANSI_COLORS[2] + ';'], ['102', 'background-color:' + ANSI_COLORS[10] + ';'],
    ['43', 'background-color:' + ANSI_COLORS[3] + ';'], ['103', 'background-color:' + ANSI_COLORS[11] + ';'],
    ['44', 'background-color:' + ANSI_COLORS[4] + ';'], ['104', 'background-color:' + ANSI_COLORS[12] + ';'],
    ['45', 'background-color:' + ANSI_COLORS[5] + ';'], ['105', 'background-color:' + ANSI_COLORS[13] + ';'],
    ['46', 'background-color:' + ANSI_COLORS[6] + ';'], ['106', 'background-color:' + ANSI_COLORS[14] + ';'],
    ['47', 'background-color:' + ANSI_COLORS[7] + ';'], ['107', 'background-color:' + ANSI_COLORS[15] + ';'],
  ])
  const ANSI_CLOSE = new Set(['', '21', '22', '23', '24', '25', '27', '28', '29', '39', '49'])
  const ANSI_TEST_RE = /(?:(?:\u001b\[)|\u009b)(?:(?:[0-9]{1,3})?(?:(?:;[0-9]{0,3})*)?[A-M|f-m])|\u001b[A-M]/
  const ANSI_SEQ_RE = /\u001b\[([\d;]*)([A-M|f-m])/g
  const ansiStyle = (strcode) => {
    if (!strcode) return ''
    const codes = String(strcode).split(';')
    let res = ''
    for (let i = 0; i < codes.length; i++) {
      const code = codes[i]
      if (ANSI_MAP.has(code)) { res += ANSI_MAP.get(code); continue }
      if (code === '38') {
        if (codes[i + 1] === '5' && codes[i + 2]) { res += 'color:' + ANSI_COLORS[Number(codes[i + 2])] + ';'; i += 2 }
        else if (codes[i + 1] === '2' && codes[i + 2] && codes[i + 3] && codes[i + 4]) { res += 'color:rgb(' + Number(codes[i + 2]) + ',' + Number(codes[i + 3]) + ',' + Number(codes[i + 4]) + ');'; i += 4 }
        continue
      }
      if (code === '48') {
        if (codes[i + 1] === '5' && codes[i + 2]) { res += 'background-color:' + ANSI_COLORS[Number(codes[i + 2])] + ';'; i += 2 }
        else if (codes[i + 1] === '2' && codes[i + 2] && codes[i + 3] && codes[i + 4]) { res += 'background-color:rgb(' + Number(codes[i + 2]) + ',' + Number(codes[i + 3]) + ',' + Number(codes[i + 4]) + ');'; i += 4 }
        continue
      }
    }
    return res
  }
  const ansiHtml = (str) => {
    str = String(str)
    if (!ANSI_TEST_RE.test(str)) return str
    let openTags = 0
    let ret = str.replace(ANSI_SEQ_RE, (m, m1, m2) => {
      if (m2 !== 'm') return ''
      if (m1 === '0') {
        if (openTags > 0) { const ct = '</span>'.repeat(openTags); openTags = 0; return ct }
        return ''
      }
      if (ANSI_CLOSE.has(m1)) {
        if (openTags > 0) { openTags--; return '</span>' }
        return ''
      }
      openTags++
      if (ANSI_MAP.has(m1)) return '<span style="' + ANSI_MAP.get(m1) + '">'
      const st = ansiStyle(m1)
      if (st) return '<span style="' + st + '">'
      openTags--
      return ''
    })
    if (openTags > 0) ret += '</span>'.repeat(openTags)
    return ret
  }
  const hasAnsi = (c) => { return /[\u001b\u009b]/.test(String(c)) }
  const stripAnsiJs = (c) => {
    return String(c).replace(/\u001b\[[0-9;]*[A-Za-z]/g, '').replace(/\u001b\][^\x07]*(\x07|\x1b\\)/g, '').replace(/[\u001b\u009b]/g, '').replace(/\r/g, '')
  }

  const app = Vue.createApp({
    data() {
      return {
        busy: false, sessionId: '', sessions: [], models: [], currentModel: '', pinnedSessions: [],
        deleting: {}, messages: [], inputText: '', todos: [], runId: '',
        commands: [], cmdOpen: false, cmdIdx: -1,
        histList: [], histIdx: -1, histDraft: '',
        sessionPanelOpen: false, dropdown: '', modelLoading: false,
        runMode: 'serve', modeOverlay: false, modeBusy: false,
        notifyMsg: '', notifyShow: false, loading: false,
        notifyType: 'ok',
        ocVersion: '', installOverlay: true, installErr: '', installProgress: 'This may take a minute', installLog: [], installCmd: '', installBusy: false,
        ctxUsed: 0, ctxLimit: 0, ctxPct: 0, ctxModel: '',
        question: null, qSel: [], qCustom: [], qSubmitting: false, qEl: null,
        permission: null, permissionSubmitting: false,
        loginOverlay: false, loginBusy: false, loginErr: '', loginProvider: 'opencode', loginKey: '',
        loginFetched: false, loginConnected: [],
        loginProviders: [
          { id: 'opencode', name: 'OpenCode Zen', hint: 'token from opencode.ai/auth — free models available' },
          { id: 'openai', name: 'openai', hint: '' },
          { id: 'anthropic', name: 'anthropic', hint: '' },
          { id: 'google', name: 'google', hint: 'Gemini' },
          { id: 'openrouter', name: 'openrouter', hint: '' },
          { id: 'deepseek', name: 'deepseek', hint: '' },
          { id: 'groq', name: 'groq', hint: '' },
        ],
        sseMain: null, mainReady: false, sseHandlers: {}, switching: false,
        _lastRunSession: ''
      }
    },
    computed: {
      sessionLabel() {
        const s = this.sessions.find(function(x) { return x.id === this.sessionId }, this) || this.pinnedSessions.find(function(x) { return x.id === this.sessionId }, this)
        if (s) return (this.sessionTitle(s) || '').substring(0, 25)
        return this.sessionId ? this.sessionId.slice(0, 10) + '...' : 'No session'
      },
      sessionDropdownList() {
        return this.pinnedSessions.length ? this.pinnedSessions.slice(0, 5) : this.sessions.slice(0, 10)
      },
      totalSessions() {
        return this.pinnedSessions.length + this.sessions.length
      },
      cleanModels() {
        const self = this
        const out = []
        this.models.forEach((m) => { const c = m.replace(/\r/g, ''); if (out.indexOf(c) < 0) out.push(c) })
        return out
      },
      cmdFiltered() {
        if (!this.cmdOpen) return []
        const q = this.inputText.replace(/^\s*\//, '').toLowerCase()
        const out = this.commands.filter((c) => {
          return !q || c.name.toLowerCase().indexOf(q) === 0 || c.description.toLowerCase().indexOf(q) >= 0
        })
        return out.slice(0, 8)
      },
      ctxLabel() {
        if (!this.ctxLimit) return ''
        return this.fmtK(this.ctxUsed) + ' / ' + this.fmtK(this.ctxLimit)
      },
      ctxStyle() {
        return { width: Math.min(100, this.ctxPct) + '%' }
      }
    },
    methods: {
      esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;') },
      renderOut(c) {
        const t = String(c == null ? '' : c)
        if (!hasAnsi(t)) return this.esc(t)
        if (t.length > ANSI_MAX) return this.esc(stripAnsiJs(t))
        return ansiHtml(this.esc(t))
      },
      fmtTime(ts) { if (!ts) return ''; try { return new Date(ts).toLocaleString() } catch(e) { return '' } },
      fmtK(n) {
        n = Number(n) || 0
        if (n >= 1000) return (n / 1000).toFixed(1) + 'k'
        return String(n)
      },
      sessionTitle(s) { return s.title || s.prompt || s.id },
      renderMd(t) {
        if (!t) return ''
        let html = marked.parse(t, { gfm: true, breaks: false, headerIds: false, mangle: false })
        html = html.replace(/<pre><code class="language-(\w+)">/g, '<pre><span class="code-lang">$1</span><code>')
        html = html.replace(/<pre><code class="">/g, '<pre><code>')
        html = html.replace(/<a href=/g, '<a target="_blank" href=')
        return html
      },
      mdBlocks(t) {
        if (!t) return []
        const lines = String(t).replace(/\r\n/g, '\n').split('\n')
        const blocks = []
        let cur = []
        let inFence = false
        let fenceChar = ''
        const flush = () => {
          if (cur.length && cur.join('\n').trim() !== '') blocks.push(cur.join('\n'))
          cur = []
        }
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i]
          if (!inFence) {
            const fm = /^\s*(`{3,}|~{3,})\s*[a-zA-Z0-9_-]*\s*$/.exec(line)
            if (fm) {
              flush()
              cur = [line]
              inFence = true
              fenceChar = fm[1]
              continue
            }
          } else if (line.replace(/\s+$/, '').indexOf(fenceChar) >= 0) {
            cur.push(line)
            inFence = false
            flush()
            continue
          }
          cur.push(line)
          if (!inFence && line.trim() === '') flush()
        }
        flush()
        return blocks
      },
      isOpenFence(blk) {
        const lines = String(blk).split('\n')
        let fenceChar = ''
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i]
          if (!fenceChar) {
            const fm = /^\s*(`{3,}|~{3,})\s*[a-zA-Z0-9_-]*\s*$/.exec(line)
            if (fm) fenceChar = fm[1]
          } else if (line.replace(/\s+$/, '').indexOf(fenceChar) >= 0) {
            fenceChar = ''
          }
        }
        return !!fenceChar
      },
      cachedMd(blk) {
        if (blockCache.has(blk)) return blockCache.get(blk)
        const html = this.renderMd(blk)
        blockCache.set(blk, html)
        if (blockCache.size > BLOCK_CACHE_MAX) {
          const firstKey = blockCache.keys().next().value
          if (firstKey) blockCache.delete(firstKey)
        }
        return html
      },
      mdViews(p, streaming) {
        if (!p || p.t !== 'text') return []
        const blocks = this.mdBlocks(p.c)
        const views = []
        for (let i = 0; i < blocks.length; i++) {
          const blk = blocks[i]
          let plain = false
          if (streaming && i === blocks.length - 1 && (this.isOpenFence(blk) || blk.length > STREAM_PARSE_MAX)) {
            plain = true
          }
          views.push({ text: blk, html: plain ? null : this.cachedMd(blk), plain: plain })
        }
        return views
      },
      refClass(c) {
        let rc = 'ref'
        if (/^>\s*build/.test(c)) rc += ' info'
        else if (/^\$\s/.test(c)) rc += ' cmd'
        else if (/^←/.test(c)) rc += ' edit'
        else if (/^[◈]/.test(c)) rc += ' tool'
        else rc += ' act'
        return rc
      },
      toggleDropdown(which) {
        this.dropdown = this.dropdown === which ? '' : which
      },
      viewAll() {
        this.dropdown = ''
        this.sessionPanelOpen = true
        this.loadSessions()
      },
      showNotify(msg, ok) {
        this.notifyMsg = msg
        this.notifyType = ok === false ? 'err' : 'ok'
        this.notifyShow = true
        clearTimeout(notifyTimer)
        notifyTimer = setTimeout(() => { this.notifyShow = false }, 6000)
      },
      loadSessions() {
        const self = this
        this.loading = true
        return Promise.all([
          this.fetchFend('sessions', {}, 10000).catch((e) => { self.showNotify('sessions: ' + e.message, false); return { pinned: [] } }),
          this.fetchFend('models', {}, 15000).catch((e) => { self.showNotify('models: ' + e.message, false); return { models: [] } })
        ]).then((results) => {
          self.models = (results[1] && results[1].models) || []
          self.pinnedSessions = (results[0] && results[0].pinned) || []
          return self.fetchFend('opencode_sessions', {}, 8000).catch((e) => { self.showNotify('opencode sessions: ' + e.message, false); return { sessions: [] } })
        }).then((oc) => {
          if (oc && oc.sessions) self.sessions = oc.sessions
        }).finally(() => { self.loading = false })
      },
      fetchFend(key, data, timeout) {
        return fetch('', {
          method: 'post',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({key: key, data: data, timeout: timeout || 60000})
        }).then((r) => { return r.json() })
      },
      selectModel(m) {
        this.currentModel = (m || '').replace(/\r/g, '')
        localStorage.setItem('aichat_oc_last_model', this.currentModel)
        this.dropdown = ''
        this.refreshCtx()
      },
      refreshModels() {
        const self = this
        if (this.modelLoading) return
        this.modelLoading = true
        this.fetchFend('models', { force: true, model: this.currentModel }, 20000).then((data) => {
          const list = (data && data.models) || []
          const out = []
          list.forEach((m) => { const c = String(m).replace(/\r/g, ''); if (out.indexOf(c) < 0) out.push(c) })
          self.models = out
          if (self.currentModel && out.indexOf(self.currentModel) < 0) self.currentModel = ''
          self.showNotify('Models refreshed: ' + out.length)
        }).catch((e) => {
          self.showNotify('Refresh models: ' + e.message, false)
        }).finally(() => { self.modelLoading = false })
      },
      selectSession(id) {
        const prev = this.sessionId
        this.sessionId = id
        localStorage.setItem('aichat_oc_last_session', id)
        this.dropdown = ''
        this.loadSessions()
        this.syncCtx(id)
        if (!(this.busy && id === prev)) this.loadSessionMessages(id)
      },
      loadSessionMessages(id) {
        const self = this
        this.messages = []
        this.switching = true
        return this.fetchFend('session_messages', { id: id }, 15000).then((data) => {
          self.switching = false
          if (data && Array.isArray(data.messages)) {
            self.messages = data.messages
            self.scrollBottom()
          }
          // 历史请求顺带返回当前用量，刷新页面后 ctx 直接使用后端计算的 used
          if (data && typeof data.used === 'number') {
            self.applyCtx({ type: 'ctx', used: data.used })
            if (!self.ctxLimit) self.syncCtx(id)
          }
        }).catch(() => { self.switching = false })
      },
      deleteLocalSession(id) {
        if (this.deleting[id]) return
        const self = this
        this.deleting[id] = true
        this.fetchFend('delete_session', { id: id }, 10000).then(() => {
          if (self.sessionId === id) self.sessionId = ''
          self.loadSessions()
          self.showNotify('Session deleted')
        }).catch((e) => {
          self.showNotify('Delete failed: ' + e.message, false)
        }).then(() => { delete self.deleting[id] })
      },
      deleteOCSession(id) {
        if (this.deleting[id]) return
        const self = this
        this.deleting[id] = true
        this.fetchFend('opencode_delete_session', { id: id }, 10000).then((data) => {
          if (data.ok) {
            if (self.sessionId === id) self.sessionId = ''
            self.loadSessions()
            self.showNotify('Session deleted')
          } else {
            self.showNotify('Delete failed: ' + (data.error || 'unknown'), false)
          }
        }).catch((e) => {
          self.showNotify('Delete failed: ' + e.message, false)
        }).then(() => { delete self.deleting[id] })
      },
      autosize() {
        const el = this.$refs.inputEl
        if (!el) return
        el.style.height = 'auto'
        el.style.height = Math.min(el.scrollHeight, 160) + 'px'
      },
      onInput() {
        this.autosize()
        const q = this.inputText.replace(/^\s*/, '')
        if (q.charAt(0) === '/') {
          this.cmdOpen = true
          this.cmdIdx = 0
        } else {
          this.cmdOpen = false
        }
      },
      pickCmd(c) {
        this.inputText = '/' + c.name + ' '
        this.cmdOpen = false
        this.cmdIdx = -1
        this.autosize()
        const el = this.$refs.inputEl
        if (el) el.focus()
      },
      loadCommands() {
        const self = this
        this.fetchFend('commands', {}, 8000).then((data) => {
          if (data && data.ok && Array.isArray(data.commands)) self.commands = data.commands
        }).catch(() => {})
      },
      loadHistory() {
        try {
          let arr = JSON.parse(localStorage.getItem('aichat_oc_history') || '[]')
          if (Array.isArray(arr)) this.histList = arr
        } catch(e) {}
        this.histIdx = -1
        this.histDraft = ''
      },
      saveHistory(text) {
        const t = String(text || '').trim()
        if (!t) return
        let arr = this.histList.filter((x) => { return x !== t })
        arr.push(t)
        if (arr.length > 50) arr = arr.slice(arr.length - 50)
        this.histList = arr
        this.histIdx = -1
        this.histDraft = ''
        try { localStorage.setItem('aichat_oc_history', JSON.stringify(arr)) } catch(e) {}
      },
      histNav(dir) {
        const self = this
        const list = this.histList
        if (!list.length) return
        const el = this.$refs.inputEl
        if (this.histIdx === -1) this.histDraft = this.inputText
        if (dir < 0) {
          this.histIdx = this.histIdx === -1 ? list.length - 1 : this.histIdx - 1
        } else {
          this.histIdx = this.histIdx === -1 ? -1 : this.histIdx + 1
          if (this.histIdx >= list.length) this.histIdx = -1
        }
        this.inputText = this.histIdx >= 0 ? list[this.histIdx] : this.histDraft
        this.cmdOpen = false
        this.$nextTick(() => {
          self.autosize()
          if (el) {
            el.focus()
            el.setSelectionRange(el.value.length, el.value.length)
          }
        })
      },
      onKey(e) {
        if (this.cmdOpen && this.cmdFiltered.length) {
          if (e.key === 'ArrowDown') {
            e.preventDefault()
            this.cmdIdx = (this.cmdIdx + 1) % this.cmdFiltered.length
            return
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault()
            this.cmdIdx = (this.cmdIdx - 1 + this.cmdFiltered.length) % this.cmdFiltered.length
            return
          }
          if (e.key === 'Tab') {
            e.preventDefault()
            this.pickCmd(this.cmdFiltered[this.cmdIdx >= 0 ? this.cmdIdx : 0])
            return
          }
          if (e.key === 'Enter' && !(e.ctrlKey || e.metaKey)) {
            e.preventDefault()
            this.pickCmd(this.cmdFiltered[this.cmdIdx >= 0 ? this.cmdIdx : 0])
            this.send()
            return
          }
          if (e.key === 'Escape') {
            e.preventDefault()
            this.cmdOpen = false
            this.cmdIdx = -1
            return
          }
        }
        if (e.key === 'ArrowUp' && !this.cmdOpen) {
          e.preventDefault()
          this.histNav(-1)
          return
        }
        if (e.key === 'ArrowDown' && !this.cmdOpen) {
          e.preventDefault()
          this.histNav(1)
          return
        }
        if (e.key === 'Enter') {
          if (e.ctrlKey || e.metaKey) {
            e.preventDefault()
            this.insertNewline()
          } else {
            e.preventDefault()
            this.send()
          }
        }
      },
      insertNewline() {
        const el = this.$refs.inputEl
        if (!el) return
        const start = el.selectionStart
        const end = el.selectionEnd
        this.inputText = this.inputText.slice(0, start) + '\n' + this.inputText.slice(end)
        this.autosize()
        const self = this
        this.$nextTick(() => {
          el.focus()
          el.setSelectionRange(start + 1, start + 1)
        })
      },
      scrollBottom() {
        const self = this
        this.$nextTick(() => {
          const el = self.$refs.messagesEl
          if (el) {
            el.scrollTop = el.scrollHeight
            const tos = el.querySelectorAll('.tool-out')
            for (let i = 0; i < tos.length; i++) tos[i].scrollTop = tos[i].scrollHeight
          }
        })
      },
      ensureMainSse() {
        const self = this
        return new Promise((resolve) => {
          if (self.mainReady) return resolve(true)
          let done = false
          const finish = (v) => { if (done) return; done = true; resolve(v) }
          const check = setInterval(() => { if (self.mainReady) { clearInterval(check); finish(true) } }, 100)
          setTimeout(() => { clearInterval(check); finish(true) }, 8000)
        })
      },
      async send() {
        if (this.busy) return
        const self = this
        let prompt = this.inputText.trim()
        if (!prompt) return
        if (prompt.length > 1200) {
          prompt = prompt.slice(0, 1200)
          this.showNotify('Message exceeds 1200 chars, truncated')
        }
        this.cmdOpen = false
        this.cmdIdx = -1
        if (/^\/new\s*$/.test(prompt)) {
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          this.clearChat()
          return
        }
        this.saveHistory(prompt)
        this.inputText = ''
        this.$nextTick(() => { self.autosize() })
        this.busy = true
        this.messages.push({ role: 'user', content: prompt })
        const el = Vue.reactive({ role: 'assistant', parts: [], streaming: true })
        this.messages.push(el)
        this.scrollBottom()
        // wait until the SSE channel is registered before starting the run,
        // otherwise the backend's $ws.sse stream is dropped (shows only after refresh)
        await self.ensureMainSse()
        const startTime = Date.now()
        const runId = Date.now() + '-' + Math.random().toString(36).slice(2, 8)
        this.runId = runId
        this.todos = []
        if (this.currentModel) this.ctxModel = this.currentModel

        // 文本按 SSE 到达顺序即时渲染；cls 相同（普通/ reasoning）才追加到上一段，否则新开一段
        const flushText = () => {}

        const onMsg = (data) => {
          try {
            if (data.type === 'init') {
              if (data.content && el.initShown !== data.content) {
                flushText()
                el.parts.push({ t: 'ref', c: data.content, cls: 'info' })
                el.initShown = data.content
                self.scrollBottom()
              }
              return
            }
            if (data.type === 'ref') {
              flushText()
              el.parts.push({ t: 'ref', c: data.content, cls: data.cls || '' })
            }
            if (data.type === 'out') {
              flushText()
              const lastOut = el.parts[el.parts.length - 1]
              if (lastOut && lastOut.t === 'out') lastOut.c += data.content
              else el.parts.push({ t: 'out', c: data.content })
            }
            if (data.type === 'text') {
              const cls = data.cls || ''
              const last = el.parts[el.parts.length - 1]
              if (last && last.t === 'text' && (last.cls || '') === cls) {
                last.c += data.content
              } else {
                el.parts.push({ t: 'text', c: data.content, cls: cls })
                self.scrollBottom()
              }
            }
            if (data.type === 'todo') {
              self.todos = data.data || []
            }
            if (data.type === 'ctx') {
              self.applyCtx(data)
            }
            if (data.type === 'session') {
              self.sessionId = data.id || ''
              self._lastRunSession = self.sessionId || self._lastRunSession
              try {
                if (self.sessionId) localStorage.setItem('aichat_oc_last_session', self.sessionId)
              } catch(e) {}
            }
            if (data.type === 'question') {
              self.question = data.data || null
              self.qSel = []
              self.qCustom = []
              if (self.question && self.question.questions) {
                for (let i = 0; i < self.question.questions.length; i++) {
                  self.qSel.push([])
                  self.qCustom.push('')
                }
              }
              flushText()
              self.qEl = el
              const qs = (self.question && self.question.questions) || []
              for (let i = 0; i < qs.length; i++) {
                const q = qs[i]
                let line = '❓ ' + (q.header || 'Question') + ': ' + q.question
                if (Array.isArray(q.options)) {
                  line += '\n' + q.options.map((o) => '   · ' + o.label).join('\n')
                }
                el.parts.push({ t: 'ref', c: line, cls: 'question' })
              }
              self.scrollBottom()
              return
            }
            if (data.type === 'question_done') {
              if (self.question && data.data && self.question.requestID === data.data.requestID) {
                self.qEl = null
                self.question = null
                self.qSel = []
                self.qCustom = []
              }
              return
            }
            if (data.type === 'permission') {
              self.permission = data.data || null
              flushText()
              if (self.permission) {
                const p = self.permission
                let line = '🔒 permission · ' + (p.action || 'request')
                if (Array.isArray(p.resources) && p.resources.length) {
                  line += '\n' + p.resources.map((r) => '   · ' + r).join('\n')
                }
                el.parts.push({ t: 'ref', c: line, cls: 'permission' })
              }
              self.scrollBottom()
              return
            }
            if (data.type === 'permission_done') {
              if (self.permission && data.data && self.permission.requestID === data.data.requestID) {
                const p = self.permission
                const label = data.data.reply === 'always' ? 'always allow' : data.data.reply === 'reject' ? 'reject' : 'allow once'
                el.parts.push({ t: 'ref', c: '✔ permission ' + (p.action || 'request') + ': ' + label, cls: 'answer' })
                self.permission = null
              }
              return
            }
            if (data.type === 'done') {
              flushText()
              if (data.content) el.parts.push({ t: 'text', c: data.content })
              el.streaming = false
              self.qEl = null
              self.question = null
              self.qSel = []
              self.qCustom = []
              self.permission = null
              delete self.sseHandlers[runId]
              if (!el.stopped) {
                let meta = Math.round((Date.now() - startTime) / 1000) + 's'
                if (data.tokens) {
                  // 只显示这条消息自身新增的 token，不显示包含复用缓存的上下文总量
                  const used = msgTokenUsed(data.tokens)
                  if (used) meta += ' | ⚙ ' + used.toLocaleString() + ' tokens'
                }
                if (data.steps) meta += ' | ' + data.steps + ' steps'
                if (data.model) meta += ' | ' + data.model
                if (data.timeout) {
                  meta += ' | ⚠ timed out'
                  el.errored = true
                } else {
                  meta = '✓ ' + meta
                }
                el.meta = meta
                if (data.model) self.ctxModel = data.model
                try {
                  if (data.model) localStorage.setItem('aichat_oc_ctx_model', data.model)
                } catch(e) {}
              }
              self.busy = false
              self.runId = ''
              self.todos = []
              self.loadSessions()
              // 兜底：若 sessionId 仍为空（后端 session 事件未送达），选中本次 run 实际使用的会话，
              // 而不要盲选 sessions[0]，否则会加载成另一个会话的历史。
              if (!self.sessionId && self._lastRunSession) {
                self.selectSession(self._lastRunSession)
              } else if (!self.sessionId) {
                self.loadSessions().then(() => {
                  if (self.sessions.length > 0) self.selectSession(self.sessions[0].id)
                })
              }
              self.scrollBottom()
              return
            }
            if (data.type === 'error') {
              flushText()
              el.streaming = false
              el.errored = true
              self.question = null
              self.qSel = []
              self.qCustom = []
              self.permission = null
              if (el.stopped) {
                if (data.content && data.content !== 'client disconnected') {
                  el.meta = (el.meta ? el.meta + ' | ' : '') + '⚠ ' + data.content
                }
                delete self.sseHandlers[runId]
                self.busy = false
                self.runId = ''
                self.todos = []
                self.scrollBottom()
                return
              }
              if (el.parts.length) {
                el.meta = (el.meta ? el.meta + ' | ' : '') + '⚠ ' + data.content
              } else {
                el.parts = [{ t: 'text', c: 'Error: ' + data.content, cls: 'err-text' }]
              }
              delete self.sseHandlers[runId]
              self.busy = false
              self.runId = ''
              self.todos = []
              self.scrollBottom()
              return
            }
            self.scrollBottom()
          } catch(e) {}
        }
        self.sseHandlers[runId] = onMsg

        this.fetchFend('start', { prompt: prompt, runId: runId, session: this.sessionId, model: this.currentModel }, 120000).then((data) => {
          if (!data.ok) {
            el.errored = true; el.streaming = false
            el.parts = [{ t: 'text', c: 'Error: ' + (data.error || 'failed to start'), cls: 'err-text' }]
            self.busy = false
            self.runId = ''
            self.todos = []
            delete self.sseHandlers[runId]
            self.scrollBottom()
          } else if (data.sessionId) {
            self.sessionId = data.sessionId
            try {
              if (self.sessionId) localStorage.setItem('aichat_oc_last_session', self.sessionId)
            } catch(e) {}
          }
        }).catch((e) => {
          flushText()
          if (el.parts.length) {
            el.streaming = false
            el.meta = 'Connection closed'
          } else {
            el.errored = true; el.streaming = false
            el.parts = [{ t: 'text', c: 'Error: ' + e.message, cls: 'err-text' }]
          }
          self.busy = false
          self.runId = ''
          self.todos = []
          delete self.sseHandlers[runId]
          self.scrollBottom()
        })
      },
      stop() {
        const self = this
        const runId = this.runId
        const sessionId = this.sessionId
        const last = this.messages[this.messages.length - 1]
        if (last && last.role === 'assistant' && last.streaming) {
          last.streaming = false
          last.stopped = true
          last.errored = true
          last.meta = (last.meta ? last.meta + ' | ' : '') + '⏹ stopped'
        }
        this.fetchFend('stop', { runId: runId, session: sessionId }, 15000).then((data) => {
          if (!data.ok) {
            self.showNotify('stop failed: ' + (data.error || (data.code ? 'code ' + data.code : 'unknown')), false)
          }
          self.busy = false
        }).catch((e) => {
          self.showNotify('stop error: ' + e.message, false)
          self.busy = false
        })
      },
      qToggle(qi, label) {
        if (!this.question || this.qSubmitting) return
        const q = this.question.questions[qi]
        const cur = (this.qSel[qi] || []).slice()
        const idx = cur.indexOf(label)
        if (idx >= 0) cur.splice(idx, 1)
        else cur.push(label)
        this.qSel[qi] = q.multiple ? cur : cur.slice(-1)
        this.qSel = this.qSel.slice()
      },
      qSubmit() {
        const self = this
        if (!this.question || this.qSubmitting) return
        const answers = []
        const formAnswers = {}
        this.question.questions.forEach((q, qi) => {
          const arr = (this.qSel[qi] || []).slice()
          const custom = (this.qCustom[qi] || '').trim()
          if (custom && q.custom !== false && arr.indexOf(custom) < 0) arr.push(custom)
          answers.push(arr)
          const key = q.key || ('q' + qi)
          if (arr.length) formAnswers[key] = q.multiple ? arr : arr[0]
        })
        this.qSubmitting = true
        const qData = this.question
        this.fetchFend('question_reply', {
          requestID: this.question.requestID,
          sessionID: this.question.sessionID,
          answers: answers,
          formAnswers: formAnswers,
          form: !!this.question.form
        }, 15000).then((data) => {
          self.qSubmitting = false
          if (data && data.ok) {
            if (self.qEl && qData && Array.isArray(qData.questions)) {
              const lines = qData.questions.map((q, qi) => {
                const arr = (self.qSel[qi] || []).slice()
                const custom = (self.qCustom[qi] || '').trim()
                if (custom && q.custom !== false && arr.indexOf(custom) < 0) arr.push(custom)
                return '✔ ' + (q.header || 'Answer') + ': ' + (arr.length ? arr.join(', ') : '(no selection)')
              })
              self.qEl.parts.push({ t: 'ref', c: lines.join('\n'), cls: 'answer' })
            }
            self.qEl = null
            self.question = null
            self.qSel = []
            self.qCustom = []
          } else {
            self.showNotify('Reply failed: ' + ((data && data.error) || 'unknown'), false)
          }
        }).catch((e) => {
          self.qSubmitting = false
          self.showNotify('Reply failed: ' + e.message, false)
        })
      },
      qReject() {
        const self = this
        if (!this.question || this.qSubmitting) return
        this.qSubmitting = true
        this.fetchFend('question_reject', { requestID: this.question.requestID, sessionID: this.question.sessionID, form: !!this.question.form }, 15000).then((data) => {
          self.qSubmitting = false
          if (data && data.ok) {
            if (self.qEl) self.qEl.parts.push({ t: 'ref', c: '✖ question dismissed', cls: 'answer' })
            self.qEl = null
            self.question = null
            self.qSel = []
            self.qCustom = []
          } else {
            self.showNotify('Reject failed: ' + ((data && data.error) || 'unknown'), false)
          }
        }).catch((e) => {
          self.qSubmitting = false
          self.showNotify('Reject failed: ' + e.message, false)
        })
      },
      permissionReply(reply) {
        const self = this
        if (!this.permission || this.permissionSubmitting) return
        this.permissionSubmitting = true
        const p = this.permission
        this.fetchFend('permission_reply', { requestID: p.requestID, sessionID: p.sessionID, reply: reply, legacy: p.legacy }, 15000).then((data) => {
          self.permissionSubmitting = false
          if (data && data.ok) {
            const label = reply === 'always' ? 'always allow' : reply === 'reject' ? 'reject' : 'allow once'
            self.showNotify('Permission ' + label + ': ' + (p.action || 'request'))
            self.permission = null
          } else {
            self.showNotify('Permission reply failed: ' + ((data && data.error) || 'unknown'), false)
          }
        }).catch((e) => {
          self.permissionSubmitting = false
          self.showNotify('Permission reply failed: ' + e.message, false)
        })
      },
      clearChat() {
        this.messages = []
        this.sessionId = ''
        this.qEl = null
        this.question = null
        this.qSel = []
        this.qCustom = []
        this.permission = null
        this.ctxUsed = 0
        this.ctxPct = 0
        try { localStorage.removeItem('aichat_oc_last_session') } catch(e) {}
      },
      compactChat() {
        const self = this
        // 保留当前页面内容，压缩过程与结果在当前对话末尾追加显示
        this.inputText = '/compact'
        this.$nextTick(() => {
          self.send()
        })
      },
      startInstall() {
        if (this.installBusy) return
        const self = this
        this.installBusy = true
        this.installErr = ''
        this.installLog = []
        this.installCmd = ''
        this.installProgress = 'This may take a minute'
        // 安装进度复用 opencode-main SSE（sseMain），不再另开随机通道；
        // 后端消息带 install: true 标记，由 mainEs.onmessage 路由到 onInstallMsg
        this.fetchFend('ensure_opencode', {}, 120000).then((data) => {
          if (data && data.ok && !data.installing) {
            self.installBusy = false
            if (data.version) self.ocVersion = String(data.version).replace(/^opencode\s*/i, '')
            self.initApp()
          } else if (data && !data.ok && data.error) {
            self.installBusy = false
            self.installErr = data.error
          } else if (data && data.ok && data.installing) {
            self.$nextTick(() => {
              const el = self.$refs.installLog
              if (el) el.scrollTop = el.scrollHeight
            })
          }
        }).catch((e) => {
          self.installBusy = false
        })
      },
      onInstallMsg(d) {
        const self = this
        if (!self.installBusy) return
        if (d.type === 'cmd') {
          self.installCmd = d.content
          return
        }
        if (d.type === 'full_log') {
          self.installLog = String(d.content).split('\n').filter(Boolean)
          self.$nextTick(() => {
            const el = self.$refs.installLog
            if (el) el.scrollTop = el.scrollHeight
          })
          return
        }
        if (d.type === 'progress') {
          self.installLog.push(String(d.content).replace(/\s+/g, ' ').trim())
          if (self.installLog.length > 200) self.installLog.shift()
          self.$nextTick(() => {
            const el = self.$refs.installLog
            if (el) el.scrollTop = el.scrollHeight
          })
          return
        }
        if (d.type === 'done') {
          self.installBusy = false
          if (d.version) self.ocVersion = String(d.version).replace(/^opencode\s*/i, '')
          self.initApp()
        }
        if (d.type === 'error') {
          self.installBusy = false
          self.installErr = d.content
        }
      },
      retryInstall() {
        const self = this
        self.startInstall()
      },
      openLogin() {
        const self = this
        this.loginOverlay = true
        this.loginErr = ''
        if (this.loginFetched) return
        this.fetchFend('login_check', {}, 12000).then((data) => {
          self.loginFetched = true
          if (data && data.ok) {
            const list = (data.providers && data.providers.length) ? data.providers : self.loginProviders
            self.loginProviders = list
            self.loginConnected = data.connected || [];
            if (self.loginProvider === 'opencode' && !self.loginProviders.some((p) => p.id === 'opencode')) {
              self.loginProvider = (self.loginProviders[0] || {}).id || ''
            }
          } else if (data && data.serverDown) {
            self.loginErr = 'opencode server is not running'
          }
        }).catch((e) => { self.loginErr = e.message })
      },
      submitLogin() {
        const self = this
        const provider = this.loginProvider
        const key = this.loginKey.trim()
        if (!provider) { this.loginErr = 'Please select a provider'; return }
        if (!key) { this.loginErr = 'Please enter an API key'; return }
        this.loginBusy = true
        this.loginErr = ''
        this.fetchFend('login_apikey', { provider: provider, key: key }, 30000).then((data) => {
          self.loginBusy = false
          if (data && data.ok) {
            self.loginOverlay = false
            self.loginKey = ''
            self.showNotify('API key saved for ' + provider + '. Start a chat and pick a model above.')
            self.loadSessions()
          } else {
            self.loginErr = (data && data.error) || 'login failed'
          }
        }).catch((e) => {
          self.loginBusy = false
          self.loginErr = e.message
        })
      },
      maybeAskLogin() {
        const self = this
        if (this.loginOverlay || this.models.length) return
        this.fetchFend('login_check', {}, 12000).then((data) => {
          if (data && data.ok && data.possible) {
            self.loginFetched = true
            const providers = data.providers && data.providers.length ? data.providers : self.loginProviders
            self.loginProviders = providers
            self.loginConnected = data.connected || []
            self.loginProvider = providers.some((p) => p.id === 'opencode') ? 'opencode' : (((providers[0] || {}).id) || '')
            self.loginErr = ''
            self.loginOverlay = true
          }
        }).catch(() => {})
      },
      loadMode() {
        const self = this
        return this.fetchFend('mode', {}, 8000).then((data) => {
          if (data && data.mode) self.runMode = data.mode
        }).catch(() => {})
      },
      toggleRunMode() {
        this.modeOverlay = true
      },
      applyRunMode() {
        const self = this
        if (this.modeBusy) return
        const next = this.runMode === 'run' ? 'serve' : 'run'
        this.modeBusy = true
        this.fetchFend('set_mode', { mode: next }, 20000).then((data) => {
          self.modeBusy = false
          if (data && data.ok) {
            self.runMode = data.mode || next
            self.modeOverlay = false
            self.showNotify(self.runMode === 'run' ? 'Mode: opencode run (one-shot per message)' : 'Mode: opencode serve')
          } else {
            self.showNotify('Failed to switch mode', false)
          }
        }).catch((e) => {
          self.modeBusy = false
          self.showNotify('Mode switch: ' + e.message, false)
        })
      },
      initApp() {
        if (_inited) return
        _inited = true
        this.installOverlay = false
        this.loading = true
        const self = this
        this.loadMode()
        this.loadCommands()
        this.loadHistory()
        this.loadSessions().then(() => {
          self.loading = false
          const savedModel = localStorage.getItem('aichat_oc_last_model')
          if (savedModel) self.currentModel = savedModel.replace(/\r/g, '')
          const savedSession = localStorage.getItem('aichat_oc_last_session')
          if (savedSession && savedSession !== self.sessionId && savedSession !== '') {
            for (let i = 0; i < self.sessions.length; i++) {
              if (self.sessions[i].id === savedSession) { self.selectSession(savedSession); break }
            }
          }
          self.refreshCtx()
          self.maybeAskLogin()
        })
      },
      refreshCtx() {
        const self = this
        this.fetchFend('ctxinfo', { model: this.currentModel }, 10000).then((data) => {
          if (data && data.limit) {
            self.ctxLimit = data.limit
            if (data.model) self.ctxModel = data.model
          } else {
            const saved = localStorage.getItem('aichat_oc_ctx_limit')
            if (saved) self.ctxLimit = Number(saved)
            const savedModel = localStorage.getItem('aichat_oc_ctx_model')
            if (savedModel && !self.ctxModel) self.ctxModel = savedModel
          }
          if (self.sessionId) self.syncCtx(self.sessionId)
        }).catch(() => {})
      },
      applyCtx(d) {
        const self = this
        if (!d || d.type !== 'ctx') return
        self.ctxUsed = d.used || 0
        if (d.limit > 0) self.ctxLimit = d.limit
        if (d.pct !== undefined && d.pct !== null) self.ctxPct = d.pct
        else if (self.ctxLimit) self.ctxPct = Math.round((self.ctxUsed || 0) / self.ctxLimit * 1000) / 10
        if (d.model) self.ctxModel = d.model
        try {
          if (self.ctxLimit) localStorage.setItem('aichat_oc_ctx_limit', String(self.ctxLimit))
          if (self.ctxModel) localStorage.setItem('aichat_oc_ctx_model', self.ctxModel)
        } catch(e) {}
      },
      syncCtx(sessionId) {
        if (!sessionId) return
        const self = this
        this.fetchFend('session_ctx', { id: sessionId, model: this.currentModel || this.ctxModel }, 12000).then((data) => {
          if (!data) return
          if (data.used) self.applyCtx({ type: 'ctx', used: data.used, limit: data.limit || 0 })
        }).catch(() => {})
      },
    },
    mounted() {
      const self = this
      document.addEventListener('click', () => { self.dropdown = '' })

      const mainEs = new EventSource('/sse/elecV2P/opencode-main')
      self.sseMain = mainEs
      mainEs.onmessage = (e) => {
        try {
          const d = JSON.parse(e.data)
          if (d.runId && self.sseHandlers[d.runId]) {
            self.sseHandlers[d.runId](d)
            return
          }
          // ctx 帧全局生效（如 compact 收尾后的用量更新可能晚于该 runId handler 清理）
          if (d.type === 'ctx') {
            self.applyCtx(d)
            return
          }
          if (d.install) {
            self.onInstallMsg(d)
            return
          }
          if (d.type === 'init') {
            self.mainReady = true
            return
          }
        } catch(e) {}
      }
      mainEs.onerror = () => {}

      this.startInstall()
    }
  })

  app.mount('#app')
</script>

<script favend>
// @grant persist
const { spawn, exec } = require('child_process')

const OC_BIN = 'opencode'

const stripAnsi = (s) => { return String(s).replace(/\u001b\[[0-9;]*[a-zA-Z]/g, '').replace(/\r/g, '') }
const isAlive = (pid) => { try { process.kill(Number(pid), 0); return true } catch(e) { return false } }

const SECRET_MASK = '***'
const SECRET_RE = /((?:api[_-]?key|access_token|auth[_-]?token|api_token|client_secret|session_id|sessionid|secret|password|passwd|token))(["']?)(\s*)([:=])(\s*)(?:"([^"]*)"|'([^']*)'|([^\s,;{}]+))/gi
const maskSecrets = (s) => {
  if (!s) return s
  return String(s)
    .replace(SECRET_RE, (m, key, qk, ws1, sep, ws2, dq, sq, plain) => {
      return key + qk + ws1 + sep + ws2 + (dq !== undefined ? '"' + SECRET_MASK + '"' : sq !== undefined ? "'" + SECRET_MASK + "'" : SECRET_MASK)
    })
    .replace(/(Bearer\s+)[A-Za-z0-9._~+\/=:-]+/gi, '$1' + SECRET_MASK)
    .replace(/\b(?:sk-[A-Za-z0-9_-]{6,}|sign[a-z0-9_.-]{8,}|eyJ[A-Za-z0-9_-]{10,})\b/gi, SECRET_MASK)
    .replace(/([a-z][a-z0-9+.-]*:\/\/)[^\/\s:@]*:([^@\s]+)@/gi, '$1' + SECRET_MASK + ':' + SECRET_MASK + '@')
}

const toolArg = (inp) => {
  const i = inp || {}
  // skill 工具的参数为 { id: '<skill id>' }
  let arg = i.command || i.filePath || i.path || i.url || i.pattern || i.query || i.id || ''
  if (i.filePath) {
    const off = Number(i.offset)
    const lim = Number(i.limit)
    if (!isNaN(off) && !isNaN(lim) && lim > 0) arg += ' · L' + off + '-' + (off + lim - 1)
    else if (!isNaN(lim) && lim > 0) arg += ' · ' + lim + ' lines'
    else if (!isNaN(off) && off > 0) arg += ' · from L' + off
  }
  if (typeof i.old_string === 'string' || typeof i.new_string === 'string') {
    const oldLines = typeof i.old_string === 'string' && i.old_string ? i.old_string.split('\n').length : 0
    const newLines = typeof i.new_string === 'string' && i.new_string ? i.new_string.split('\n').length : 0
    arg += ' · -' + oldLines + '/+' + newLines
  }
  if (arg.length > 200) arg = arg.slice(0, 200) + ' …'
  return arg
}

const IS_WIN = process.platform === 'win32'
const IS_PAAS = !!process.env.PAAS
const DEVNULL = IS_WIN ? 'nul' : '/dev/null'
let serverProc = null
const redirCmd = (cmd) => { return cmd + ' 2>' + DEVNULL }
const sleep = (ms) => { return new Promise((resolve) => { setTimeout(resolve, ms) }) }

let _svcUrl = ''
let _svcAuth = ''
let _svcFetchAt = 0
let serverReadyAt = 0
let serverReadyOk = false

const serverReady = async (force) => {
  const now = Date.now()
  if (!force && now - serverReadyAt < 5000) return serverReadyOk
  try {
    const svc = await getServiceInfo()
    if (!svc.url) { serverReadyOk = false; serverReadyAt = now; return false }
    const url = new URL(svc.url)
    const httpMod = url.protocol === 'https:' ? require('https') : require('http')
    return await new Promise((resolve) => {
      const req = httpMod.get({ hostname: url.hostname, port: url.port || (url.protocol === 'https:' ? 443 : 80), path: '/api/session', headers: { 'Authorization': svc.auth } }, (res) => {
        serverReadyOk = res.statusCode === 200
        serverReadyAt = now
        resolve(serverReadyOk)
      })
      req.on('error', () => { serverReadyOk = false; serverReadyAt = now; resolve(false) })
      req.setTimeout(3000, () => { req.destroy(); serverReadyOk = false; serverReadyAt = now; resolve(false) })
    })
  } catch(e) {
    serverReadyOk = false
    serverReadyAt = now
    return false
  }
}

const execAsync = (cmd, timeout) => {
  return new Promise((resolve, reject) => {
    exec(cmd, { timeout: timeout || 15000, windowsHide: true, encoding: 'utf-8', maxBuffer: 5 * 1024 * 1024 }, (error, stdout, stderr) => {
      if (error) reject(error)
      else resolve({ stdout: stdout || '', stderr: stderr || '' })
    })
  })
}

const getServiceInfo = async () => {
  const now = Date.now()
  if (_svcUrl && now - _svcFetchAt < 30000) return { url: _svcUrl, auth: _svcAuth }
  try {
    const r = await execAsync(OC_BIN + ' service status', 5000)
    const out = (r.stdout || '').trim()
    const m = out.match(/^https?:\/\/[^\s]+/)
    if (m) {
      _svcUrl = m[0]
      const fs = require('fs')
      const svcCfg = JSON.parse(fs.readFileSync(require('os').homedir() + '/.config/opencode/service.json', 'utf8'))
      const pwd = svcCfg.password
      if (pwd) _svcAuth = 'Basic ' + Buffer.from('opencode:' + pwd).toString('base64')
      _svcFetchAt = now
      return { url: _svcUrl, auth: _svcAuth }
    }
  } catch(e) {}
  return { url: '', auth: '' }
}

const apiRequest = async (method, path, body) => {
  const info = await getServiceInfo()
  if (!info.url) throw new Error('opencode service not running')
  const url = new URL(info.url)
  return new Promise((resolve, reject) => {
    const httpMod = url.protocol === 'https:' ? require('https') : require('http')
    const payload = body ? JSON.stringify(body) : ''
    const opts = {
      host: url.hostname,
      port: url.port || (url.protocol === 'https:' ? 443 : 80),
      path: '/api' + path,
      method: method,
      headers: Object.assign({
        'Authorization': info.auth
      }, body ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) } : {})
    }
    const req = httpMod.request(opts, (res) => {
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => { 
        try {
          const parsed = JSON.parse(buf)
          resolve(parsed.data !== undefined ? parsed.data : parsed)
        } catch(e) {
          resolve({ status: res.statusCode, body: buf })
        }
      })
    })
    req.on('error', reject)
    req.setTimeout(15000, () => { req.destroy(); reject(new Error('timeout')) })
    if (body) req.write(payload)
    req.end()
  })
}

const apiGet = (path) => apiRequest('GET', path)
const apiPost = (path, body) => apiRequest('POST', path, body)
const apiPut = (path, body) => apiRequest('PUT', path, body)
const apiPatch = (path, body) => apiRequest('PATCH', path, body)
const apiDelete = (path) => apiRequest('DELETE', path)

const getRunMode = () => {
  try { return $store.get('opencode_run_mode') === 'run' ? 'run' : 'serve' } catch(e) { return 'serve' }
}

const syncRunCache = (sessionId, newTitle) => {
  if (!sessionId) return
  try {
    let cache = []
    try { cache = JSON.parse($store.get('aichat_oc_sessions_cache') || '[]') } catch(e) {}
    if (!Array.isArray(cache)) cache = []
    const now = Date.now()
    const idx = cache.findIndex((s) => { return s && s.id === sessionId })
    if (idx < 0) {
      const title = newTitle || ('New session - ' + new Date(now).toISOString())
      cache.unshift({ id: sessionId, title: title, created: now, updated: now })
    } else {
      const it = cache.splice(idx, 1)[0]
      cache.unshift(Object.assign({}, it, { updated: now }))
    }
    $store.set('aichat_oc_sessions_cache', JSON.stringify(cache))
    $store.set('aichat_oc_sessions_time', String(Date.now()))
  } catch(e) {}
}

const stopServe = () => {
  try { shutdownServer() } catch(e) {}
  try {
    const pid = $store.get('opencode_server_pid')
    if (pid && isAlive(pid)) { try { process.kill(Number(pid), 'SIGTERM') } catch(e) {} }
  } catch(e) {}
}

const emitOut = (lastStore, callId, out, sendFn) => {
  if (!out) return
  const prev = lastStore[callId]
  if (prev && prev.raw === out) return
  const masked = maskSecrets(out)
  let delta = ''
  if (prev && prev.masked && masked.indexOf(prev.masked) === 0) {
    delta = masked.slice(prev.masked.length)
  } else if (prev) {
    delta = '\n' + masked
  } else {
    delta = masked
  }
  if (delta) sendFn(delta)
  lastStore[callId] = { raw: out, masked: masked }
}

const toolOut = (out) => {
  if (out == null) return ''
  if (typeof out === 'string') return out
  if (Array.isArray(out)) {
    let buf = ''
    for (const o of out) {
      if (o == null) continue
      const seg = typeof o === 'string' ? o : (o.text != null ? (typeof o.text === 'string' ? o.text : JSON.stringify(o.text)) : null)
      if (seg == null) continue
      if (buf) buf += '\n'
      buf += seg
    }
    return buf
  }
  if (out.text != null) return typeof out.text === 'string' ? out.text : JSON.stringify(out.text)
  try { return JSON.stringify(out) } catch (e) { return String(out) }
}

const ensureServer = async () => {
  // v2: 后台服务由 `opencode service` 管理，动态端口，不再自行 spawn `opencode serve --port 14096`
  if (await serverReady()) return true
  try { await execAsync(OC_BIN + ' service start', 10000) } catch(e) {}
  const deadline = Date.now() + 15000
  while (Date.now() < deadline) {
    if (await serverReady(true)) return true
    await sleep(1000)
  }
  return false
}

const shutdownServer = () => {
  if (serverProc && !serverProc.killed) {
    try { serverProc.kill('SIGTERM') } catch(e) {}
  }
}
try {
  if (!process.__oc_shutdown_added) {
    process.__oc_shutdown_added = true
    process.on('SIGTERM', shutdownServer)
    process.on('SIGINT', shutdownServer)
    process.on('exit', shutdownServer)
  }
} catch(e) {}

const runProcs = {}

const parseModel = (modelStr) => {
  let pid = 'opencode', mid = ''
  if (modelStr) {
    const sl = modelStr.indexOf('/')
    if (sl > 0) { pid = modelStr.slice(0, sl); mid = modelStr.slice(sl + 1) }
    else mid = modelStr
  }
  return { pid: pid, mid: mid }
}

const ctxLimitMem = {}
const getCtxLimit = async (modelStr) => {
  const pm = parseModel(modelStr)
  if (!pm.mid) return 0
  const memKey = pm.pid + '/' + pm.mid
  if (ctxLimitMem[memKey] > 0) return ctxLimitMem[memKey]
  const cacheKey = 'aichat_ctx_limit_' + pm.pid + '_' + pm.mid
  try {
    const cached = Number($store.get(cacheKey))
    if (cached > 0) { ctxLimitMem[memKey] = cached; return cached }
  } catch(e) {}
  // v2: GET /api/model 返回含 limit.context 的模型列表
  try {
    const models = await apiGet('/model')
    const list = Array.isArray(models) ? models : (models && models.data) || []
    for (const m of list) {
      if ((m.providerID === pm.pid) && (m.modelID === pm.mid || m.id === pm.mid) && m.limit && m.limit.context) {
        const limit = m.limit.context
        ctxLimitMem[memKey] = limit
        try { $store.set(cacheKey, String(limit)) } catch(e2) {}
        return limit
      }
    }
  } catch(e) {}
  return 0
}

$fend('ctxinfo', (data) => {
  const modelStr = data && data.model ? data.model : ''
  const pm = parseModel(modelStr)
  return getCtxLimit(modelStr).then((limit) => {
    return { model: pm.mid || '', limit: limit }
  })
})

// v2 tokens 结构为 { input, output, reasoning, cache: { read, write } }，无 total 字段
// 与 opencode TUI 的 contextUsage 保持一致：全部相加才是模型报告的完整用量
const tokenTotal = (t) => {
  if (!t) return 0
  if (t.total != null) return Number(t.total) || 0
  return (Number(t.input) || 0) + (Number(t.output) || 0) + (Number(t.reasoning) || 0) + ((t.cache && Number(t.cache.read)) || 0) + ((t.cache && Number(t.cache.write)) || 0)
}

// 消息自身新增的 token：从上下文快照里去掉复用缓存 cache.read。
// 用于消息结尾 footer；右上角 ctx 仍用 tokenTotal（完整上下文占用）。
const msgTokenUsed = (t) => {
  if (!t) return 0
  if (t.total != null) return Number(t.total) || 0
  return Math.max(0, tokenTotal(t) - ((t.cache && Number(t.cache.read)) || 0))
}

// opencode 把压缩用量拆成 input+cache（读进来的旧上下文）和 output+reasoning（生成的摘要）。
// 这里按“压缩前 → 压缩后”显示，数字全部来自工具报告，不自己推算。
const compactBefore = (t) => (Number(t && t.input) || 0) + ((t && t.cache && Number(t.cache.read)) || 0) + ((t && t.cache && Number(t.cache.write)) || 0)
const compactAfter = (t) => (Number(t && t.output) || 0) + (Number(t && t.reasoning) || 0)
const compactRef = (t) => {
  const before = compactBefore(t)
  const after = compactAfter(t)
  return '✂ context compacted' + (before && after ? ' · ' + before.toLocaleString() + ' → ' + after.toLocaleString() + ' tokens' : '')
}

// 直接使用 opencode 自己报告的用量：从最新消息往前找。
// assistant 用其 tokens 总量（opencode TUI 的 contextUsage 也是这么算的）；
// 若最后一次动作是压缩，则用压缩报告的摘要 token 数作为压缩后的上下文估值。
// 不跨消息累加，也不把 compaction 的 input 当基线，compact 前后不会混算。
const usageFromMsgs = (msgs) => {
  if (!msgs || !msgs.length) return 0
  const sorted = msgs.slice().sort((a, b) => msgTime(a) - msgTime(b))
  for (let i = sorted.length - 1; i >= 0; i--) {
    const m = sorted[i]
    if (!m) continue
    if (m.type === 'assistant' && m.tokens) {
      const used = tokenTotal(m.tokens)
      if (used) return used
    }
    if (m.type === 'compaction' && m.tokens && (m.status === 'completed' || m.summary)) {
      const used = compactAfter(m.tokens)
      if (used) return used
    }
  }
  return 0
}

const getSessionUsage = async (sessionId) => {
  if (!sessionId) return 0
  try {
    return usageFromMsgs(await fetchSessionMessages(sessionId))
  } catch(e) {
    return 0
  }
}

$fend('session_ctx', (data) => {
  const id = data && data.id
  const modelStr = (data && data.model || '').replace(/\r/g, '')
  return getSessionUsage(id).then((used) => {
    return getCtxLimit(modelStr).then((limit) => {
      return { used: used, limit: limit }
    })
  })
})

const fetchSessionMessages = async (sessionId) => {
  if (!sessionId) return []
  let svc = { url: '', auth: '' }
  try {
    svc = await getServiceInfo()
  } catch(e) {}
  if (!svc.url) {
    svc.url = 'http://127.0.0.1:49374'
    try {
      const fs = require('fs')
      const svcCfg = JSON.parse(fs.readFileSync(require('os').homedir() + '/.config/opencode/service.json', 'utf8'))
      const pwd = svcCfg.password
      if (pwd) svc.auth = 'Basic ' + Buffer.from('opencode:' + pwd).toString('base64')
    } catch(e) {}
  }
  const url = new URL(svc.url)
  const httpMod = url.protocol === 'https:' ? require('https') : require('http')
  // v2 API: limit 最大 200，超出返回 400。分页拉齐
  const PAGE = 200
  const MAXPAGE = 5
  const fetchPage = (offset) => {
    const path = '/api/session/' + encodeURIComponent(sessionId) + '/message?limit=' + PAGE + '&offset=' + offset
    return new Promise((resolve) => {
      const opts = {
        hostname: url.hostname,
        port: url.port || (url.protocol === 'https:' ? 443 : 80),
        path,
        method: 'GET',
        headers: { 'Authorization': svc.auth }
      }
      const req = httpMod.request(opts, (res) => {
        let buf = ''
        res.on('data', (c) => { buf += c })
        res.on('end', () => {
          try {
            const parsed = JSON.parse(buf)
            resolve(Array.isArray(parsed.data) ? parsed.data : [])
          } catch(e) { resolve([]) }
        })
      })
      req.on('error', () => resolve([]))
      req.setTimeout(10000, () => { req.destroy(); resolve([]) })
      req.end()
    })
  }
  const all = []
  const seen = {}
  for (let p = 0; p < MAXPAGE; p++) {
    const list = await fetchPage(all.length)
    if (!list.length) break
    let added = 0
    for (const m of list) {
      if (m && m.id && seen[m.id]) continue
      if (m && m.id) seen[m.id] = 1
      all.push(m)
      added++
    }
    if (!added || list.length < PAGE) break
  }
  return all
}

const msgTime = (m) => {
  const t = m && m.time
  if (t && t.created) return Number(t.created)
  return Number(m && (m.created_at || m.time)) || 0
}

const convSessionMessages = (msgs) => {
  const out = []
  let cur = null
  let curTokens = 0
  let curModel = ''
  let curErrored = false
  const finalize = () => {
    if (!cur) return
    let meta = curErrored ? '⚠ ' : '✓ '
    const bits = []
    if (curModel) bits.push(curModel)
    if (curTokens) bits.push('⚙ ' + curTokens + ' tokens')
    meta += bits.join(' | ')
    cur.meta = meta.trim() || '✓'
    cur.errored = curErrored
    cur.streaming = false
    cur = null
    curTokens = 0
    curModel = ''
    curErrored = false
  }
  for (let i = 0; i < msgs.length; i++) {
    const m = msgs[i]
    const type = m.type
    if (type === 'idle') continue
    if (type === 'user') {
      finalize()
      const text = m.text || ''
      if (text.trim()) out.push({ role: 'user', content: text })
      continue
    }
    if (type === 'system') {
      finalize()
      const text = m.text || m.description || ''
      if (text.trim()) out.push({ role: 'system', content: text, meta: '📋 system' })
      continue
    }
    if (type === 'model-switched') {
      finalize()
      const model = m.model || {}
      out.push({ role: 'assistant', content: '', parts: [{ t: 'ref', c: '🔄 Model switched to ' + (model.id || 'unknown'), cls: 'info' }] })
      continue
    }
    if (type === 'compaction') {
      // 压缩摘要（完成后消息带 summary 字段）
      finalize()
      const summary = m.summary || ''
      const parts = [{ t: 'ref', c: compactRef(m.tokens), cls: 'info' }]
      if (summary) parts.push({ t: 'text', c: summary, cls: 'compact' })
      out.push({ role: 'assistant', content: '', parts: parts })
      continue
    }
    if (type === 'assistant') {
      const content = m.content || []
      const tokens = m.tokens || {}
      const model = m.model || {}
      if (!content.length) continue
      if (!cur) {
        cur = { role: 'assistant', parts: [] }
        out.push(cur)
      }
      for (let j = 0; j < content.length; j++) {
        const p = content[j]
        if (p.type === 'text' && p.text) {
          cur.parts.push({ t: 'text', c: p.text })
        } else if (p.type === 'reasoning' && p.text) {
          cur.parts.push({ t: 'ref', c: '✱ reasoning', cls: 'reasoning' })
          cur.parts.push({ t: 'text', c: p.text, cls: 'reasoning' })
          cur.parts.push({ t: 'ref', c: '✓ reasoning done', cls: 'reasoning' })
        } else if (p.type === 'tool') {
          const state = p.state || {}
          const inp = state.input || {}
          let arg = ''
          if (typeof inp === 'object' && inp !== null) {
            arg = toolArg(inp)
          } else if (typeof inp === 'string') {
            arg = inp
          }
          if (typeof arg !== 'string') arg = String(arg)
          let out2 = ''
          if (Array.isArray(state.content)) {
            out2 = state.content.filter(c => c.type === 'text').map(c => c.text).join('\n')
          } else {
            out2 = state.output || state.result || state.stdout || state.content || ''
          }
          if (typeof out2 === 'object' && out2 !== null) out2 = JSON.stringify(out2)
          const status = state.status || ''
          // 与流式一致：◈ 工具 · 参数 → 输出内容 → ✓/✗ 收尾标识
          const toolName = p.name || 'tool'
          cur.parts.push({ t: 'ref', c: '◈ ' + toolName + (arg ? ' · ' + maskSecrets(arg) : ''), cls: 'tool' })
          if (out2) cur.parts.push({ t: 'out', c: maskSecrets(out2) })
          if (status === 'error') {
            cur.parts.push({ t: 'ref', c: '✗ ' + toolName + ' failed', cls: 'tool' })
          } else {
            cur.parts.push({ t: 'ref', c: '✓ ' + toolName + ' done', cls: 'tool' })
          }
        }
      }
      // footer 只显示本条 assistant 消息自身新增的 token，不包含复用缓存 cache.read；
      // 不跨消息累加，也不取 session 累计用量
      const turnTokens = msgTokenUsed(tokens)
      if (turnTokens) curTokens = turnTokens
      if (model && model.id) curModel = (model.providerID || 'opencode') + '/' + model.id
      if (m.outcome === 'failed') curErrored = true
    }
  }
  finalize()
  return out
}

$fend('session_messages', async (data) => {
  const id = data && data.id
  if (!id) return { messages: [], used: 0 }
  try {
    const msgs = await fetchSessionMessages(id)
    msgs.sort((a, b) => msgTime(a) - msgTime(b))
    // 顺带返回当前用量：刷新页面加载历史时前端直接更新 ctx，不依赖单独的 session_ctx 请求
    return { messages: convSessionMessages(msgs), used: usageFromMsgs(msgs) }
  } catch(e) {
    return { messages: [], used: 0 }
  }
})

const runWatchdogs = {}
const sseChat = (runId, obj) => {
  if (obj && obj.type !== 'done' && obj.type !== 'error') {
    const rw = runWatchdogs[runId]
    if (rw && typeof rw.kick === 'function') rw.kick()
  }
  $ws.sse('opencode-main', JSON.stringify(Object.assign({ runId: runId }, obj)))
}

const runCliMode = async (data, runId) => {
  const prompt = data.prompt
  const sessionId = data.session || ''
  const modelStr = (data.model || '').replace(/\r/g, '')

  const qArg = (val) => {
    let s = String(val)
    if (!IS_WIN || /^[\w@%+=:,./\-]+$/.test(s)) return s
    return '"' + s.replace(/(\\*)"/g, '$1$1\\"').replace(/(\\+)$/, '$1$1') + '"'
  }
  // prompt 不放命令行（shell 会按空格/换行拆参），改走 stdin
  const args = ['run', '--format', 'json']
  if (sessionId) args.push('--session', sessionId)
  if (modelStr) args.push('--model', modelStr)

  let streamEnded = false
  let stepCount = 0
  let tokens = null
  let model = modelStr || null
  let knownSession = !!sessionId
  let runSessionId = ''
  let seenSessionSent = false
  const seenTools = {}
  const lastToolOut = {}
  const runningTools = {}
  let toolSeq = 0
  const reasoningSeen = {}
  const reasoningKey = (id) => { return id || '_' }
  const reasonStart = (id) => {
    const k = reasoningKey(id)
    if (reasoningSeen[k] !== 'start' && reasoningSeen[k] !== 'done') {
      reasoningSeen[k] = 'start'
      sendRef('✱ reasoning', 'reasoning')
    }
  }
  const reasonDone = (id) => {
    const k = reasoningKey(id)
    if (reasoningSeen[k] !== 'done') {
      reasoningSeen[k] = 'done'
      sendRef('✓ reasoning done', 'reasoning')
    }
  }
  let watchdog = null

  try { const vr = await resolveOcVersion(2); } catch(e) {}
  this.ocVersion = vr.ok ? vr.version : ''

  let aliveTimer = null
  let toolHeartbeat = null
  const kickWatchdog = () => {
    if (watchdog) clearTimeout(watchdog)
    watchdog = setTimeout(() => {
      finish({ content: '', model: model, tokens: tokens, timeout: true })
    }, 600000)
  }

  const send = (type, payload) => {
    if (type !== 'done' && type !== 'error') kickWatchdog()
    sseChat(runId, Object.assign({ type: type }, payload || {}))
  }
  const sendRef = (line, cls) => {
    send('ref', { content: line, cls: cls || '' })
  }
  const pushCtx = (used, limit) => {
    send('ctx', {
      used: used || 0, limit: limit || 0,
      pct: limit ? Math.round((used || 0) / limit * 1000) / 10 : null,
      model: model
    })
  }
  const emitCtx = (used) => {
    if (!used) return
    getCtxLimit(model).then((limit) => { pushCtx(used, limit) }).catch(() => { pushCtx(used, 0) })
  }
  const finish = (payload) => {
    if (streamEnded) return
    streamEnded = true
    if (watchdog) clearTimeout(watchdog)
    if (aliveTimer) clearInterval(aliveTimer)
    if (toolHeartbeat) clearInterval(toolHeartbeat)
    try { proc.kill() } catch(e) {}
    if (runSessionId) {
      const newTitle = knownSession ? null : String(data.prompt || '').replace(/\s+/g, ' ').trim().slice(0, 50)
      syncRunCache(runSessionId, newTitle)
    }
    send('done', Object.assign({ steps: stepCount }, payload || {}))
  }
  const fail = (msg) => {
    if (streamEnded) return
    streamEnded = true
    if (watchdog) clearTimeout(watchdog)
    if (aliveTimer) clearInterval(aliveTimer)
    if (toolHeartbeat) clearInterval(toolHeartbeat)
    try { proc.kill() } catch(e) {}
    send('error', { content: msg })
  }

  const handleEvent = (ev) => {
    const sid = ev.sessionID
    if (sid) {
      runSessionId = sid
      if (!seenSessionSent) {
        seenSessionSent = true
        if (!knownSession) send('session', { id: sid })
      }
    }
    const t = ev.type
    const part = ev.part || {}
    if (t === 'step_start') { stepCount++; return }
    if (t === 'step_finish') {
      if (part.tokens) {
        tokens = part.tokens
        const used = tokenTotal(part.tokens)
        if (used) emitCtx(used)
      }
      return
    }
    if (t === 'text') {
      if (part.text) send('text', { content: part.text })
      return
    }
    if (t === 'reasoning') { if (part.time && part.time.end) reasonDone(part.id); else reasonStart(part.id); return }
    if (t === 'file') { sendRef('▸ file ' + ((part.file && part.file.path) || ''), 'info'); return }
    if (t === 'tool_use') {
      const st = part.state || {}
      const inp = st.input || {}
      const arg = toolArg(inp)
      const callId = part.callID || part.id || (part.tool || 'tool') + '#' + (++toolSeq)
      const out = toolOut(st.output || (st.metadata && st.metadata.output))
      if (part.tool === 'question') {
        // run --format json 只在工具结束时发 tool_use，所以这里不限定 pending/running
        if (!seenTools[callId]) {
          seenTools[callId] = true
          // run 模式无法交互回答（OpenCode 会自动取消），至少把问题和选项显示出来
          const qs = (st.input && st.input.questions) || []
          let line = '◈ question asked'
          if (qs.length) {
            line += '\n' + qs.map((q, qi) => {
              let s = '❓ ' + (q.header || ('Question ' + (qi + 1))) + ': ' + (q.question || '')
              if (Array.isArray(q.options) && q.options.length) {
                s += '\n' + q.options.map((o) => '   · ' + (o.label || o.value || String(o)) + (o.description ? ' — ' + o.description : '')).join('\n')
              }
              return s
            }).join('\n')
          }
          sendRef(line, 'question')
        }
        return
      }
      if (st.status === 'pending' || st.status === 'running') {
        if (!seenTools[callId] && arg) {
          seenTools[callId] = true
          sendRef('◈ ' + (part.tool || 'tool') + ' · ' + maskSecrets(arg), 'tool')
        } else if (!seenTools[callId] && st.status === 'running') {
          seenTools[callId] = true
          sendRef('◈ ' + (part.tool || 'tool'), 'tool')
        }
        if (!runningTools[callId]) runningTools[callId] = { tool: part.tool || 'tool', arg: arg, started: Date.now() }
        if (out) runningTools[callId].lastOutput = out
        runningTools[callId].lastUpdate = Date.now()
        if (out) emitOut(lastToolOut, callId, out, (d) => { send('out', { content: d }) })
      } else if (st.status === 'completed') {
        delete runningTools[callId]
        if (!seenTools[callId]) {
          seenTools[callId] = true
          sendRef('◈ ' + (part.tool || 'tool') + (arg ? ' · ' + maskSecrets(arg) : ''), 'tool')
        }
        sendRef('✓ ' + (part.tool || 'tool') + ' done', 'tool')
        if (out) emitOut(lastToolOut, callId, out, (d) => { send('out', { content: d }) })
      } else if (st.status === 'error') {
        delete runningTools[callId]
        sendRef('✗ ' + (part.tool || 'tool') + ' failed', 'tool')
        if (out) emitOut(lastToolOut, callId, out, (d) => { send('out', { content: d }) })
      }
      return
    }
    if (t === 'todo') {
      send('todo', { data: part.todos || ev.todos || [] })
      return
    }
    if (t === 'error' || t === 'session_error') {
      const errObj = ev.error || part || {}
      const errMsg = (typeof errObj === 'string' ? errObj : (errObj.message || errObj.name || 'opencode error'))
      fail(String(errMsg).split('\n')[0])
      return
    }
  }

  const proc = spawn(OC_BIN, args.map(qArg), { env: Object.assign({}, process.env, { NODE_OPTIONS: '--no-warnings' }), windowsHide: true, shell: IS_WIN, stdio: ['pipe', 'pipe', 'pipe'] })
  try {
    proc.stdin.on('error', () => {})
    proc.stdin.write(prompt)
    proc.stdin.end()
  } catch(e) {}
  runProcs[runId] = proc
  // favend 每次请求都会重新执行整个脚本，runProcs 会变成空对象。
  // 把 proc 存进跨请求共享的 $cache，stop 时才能找到并杀掉进程。
  try { $cache.set('oc_run_' + runId, proc) } catch(e) {}

  let buf = ''
  proc.stdout.setEncoding('utf8')
  proc.stdout.on('data', (chunk) => {
    buf += chunk
    let nl
    while ((nl = buf.indexOf('\n')) >= 0) {
      const line = buf.slice(0, nl)
      buf = buf.slice(nl + 1)
      if (!line.trim()) continue
      let ev
      try { ev = JSON.parse(line.trim()) } catch(e) { continue }
      try { handleEvent(ev) } catch(e) {}
    }
  })
  proc.stderr.on('data', (chunk) => {
    const t = stripAnsi(chunk.toString()).trim()
    if (t) console.log('[opencode run]', t)
  })

  toolHeartbeat = setInterval(() => {
    if (streamEnded) { clearInterval(toolHeartbeat); return }
    const now = Date.now()
    for (const id in runningTools) {
      const tool = runningTools[id]
      if (now - tool.lastUpdate > 10000) {
        sendRef('◈ ' + tool.tool + ' running (' + Math.floor((now - tool.started) / 1000) + 's)', 'tool')
        tool.lastUpdate = now
      }
      if (tool.lastOutput) emitOut(lastToolOut, id, tool.lastOutput, (d) => { send('out', { content: d }) })
    }
  }, 15000)

  proc.on('error', (e) => { fail(e.message || String(e)) })
  proc.on('close', (code) => {
    try { delete runProcs[runId] } catch(e) {}
    try { $cache.delete('oc_run_' + runId) } catch(e) {}
    if (streamEnded) return
    if (code !== 0) fail('opencode exited with code ' + code)
    else finish({ content: '', model: model, tokens: tokens })
  })

  kickWatchdog()
  aliveTimer = setInterval(() => {
    try {
      if (typeof $ws.sseExists !== 'function' || $ws.sseExists('opencode-main')) return
      clearInterval(aliveTimer)
      aliveTimer = null
      try { proc.kill() } catch(e) {}
      fail('client disconnected')
    } catch(e) {}
  }, 15000)

  return { ok: true, runId: runId }
}

$fend('mode', async () => {
  let up = false
  try { up = await serverReady() } catch(e) {}
  return { mode: getRunMode(), serverUp: up }
})

$fend('set_mode', async (data) => {
  const mode = (data && data.mode === 'run') ? 'run' : 'serve'
  try { $store.set('opencode_run_mode', mode) } catch(e) {}
  if (mode === 'run') {
    stopServe()
    return { ok: true, mode: mode, serverUp: false }
  }
  let up = false
  try { up = await ensureServer() } catch(e) {}
  return { ok: true, mode: mode, serverUp: up }
})

$fend('start', async (data) => {
  if (!data || !data.prompt) return { error: 'prompt is required' }
  const runId = data.runId || Date.now() + '-' + Math.random().toString(36).slice(2, 8)
  if (getRunMode() === 'run' || !(await ensureServer())) return runCliMode(data, runId)
  const prompt = data.prompt
  const httpMod = require('http')

  // v2: 动态服务地址 + Basic Auth
  const svcInfo = await getServiceInfo()
  const svcUrl = svcInfo.url ? new URL(svcInfo.url) : null
  const svcBase = svcUrl ? { hostname: svcUrl.hostname, port: svcUrl.port || (svcUrl.protocol === 'https:' ? 443 : 80), protocol: svcUrl.protocol } : { hostname: '127.0.0.1', port: 80, protocol: 'http:' }

  const api = (method, path, body) => {
    return new Promise((resolve, reject) => {
      const payload = body ? JSON.stringify(body) : ''
      const url = svcUrl || new URL('http://127.0.0.1')
      const opts = {
        hostname: url.hostname,
        port: url.port || (url.protocol === 'https:' ? 443 : 80),
        path: '/api' + path, method: method,
        headers: Object.assign({ 'Authorization': svcInfo.auth }, body ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) } : {})
      }
      const req = (url.protocol === 'https:' ? require('https') : httpMod).request(opts, (res) => {
        let buf = ''
        res.on('data', (c) => { buf += c })
        res.on('end', () => { resolve({ status: res.statusCode, body: buf }) })
      })
      req.on('error', reject)
      if (body) req.write(payload)
      req.end()
    })
  }

  const streamRun = (sessionId) => {
    ;(async () => {
    // 让前端立即拿到本次 run 使用的 sessionId。
    // 否则前端 sessionId 一直为空，done 后会误判为"首次对话"而 selectSession(sessions[0])，
    // 把刚流式生成的回复清空并加载成另一个会话的历史，表现为"看不到输出/切换会话错乱"。
    try { sseChat(runId, { type: 'session', id: sessionId }) } catch(e) {}
    try {
      let ctxLimit = 0
      getCtxLimit(data.model).then((l) => { if (l) ctxLimit = l }).catch(() => {})

      let streamEnded = false
      let model = null
      let modelShown = false
      let stepCount = 0
      const seenTools = {}
      const lastToolOut = {}
      const runningTools = {}
      let toolSeq = 0
      const reasoningSeen = {}
      const reasoningKey = (id) => { return id || '_' }
      const reasonStart = (id) => {
        const k = reasoningKey(id)
        if (reasoningSeen[k] !== 'start' && reasoningSeen[k] !== 'done') {
          reasoningSeen[k] = 'start'
          sendRef('✱ reasoning', 'reasoning')
        }
      }
      const reasonDone = (id) => {
        const k = reasoningKey(id)
        if (reasoningSeen[k] !== 'done') {
          reasoningSeen[k] = 'done'
          sendRef('✓ reasoning done', 'reasoning')
        }
      }
      let tokens = null
      let watchdog = null
      runWatchdogs[runId] = {
        kick: () => {
          if (watchdog) clearTimeout(watchdog)
          watchdog = setTimeout(() => {
            finish({ content: '', model: model, tokens: tokens, timeout: true })
          }, 600000)
        }
      }
      let aliveTimer = null
      let toolHeartbeat = null

      const pushCtx = (used, limit) => {
        sseChat(runId, {
          type: 'ctx', used: used || 0, limit: limit || 0,
          pct: limit ? Math.round((used || 0) / limit * 1000) / 10 : null,
          model: model
        })
      }

      const emitCtx = (used) => {
        if (!used) return
        if (ctxLimit) return pushCtx(used, ctxLimit)
        if (model) {
          getCtxLimit(model).then((limit) => {
            if (limit) ctxLimit = limit
            pushCtx(used, ctxLimit)
          })
          return
        }
        pushCtx(used, 0)
      }

      const es = (svcUrl && svcUrl.protocol === 'https:' ? require('https') : httpMod).get({
        hostname: svcBase.hostname,
        port: svcBase.port,
        path: '/api/event',
        headers: { 'Accept': 'text/event-stream', 'Authorization': svcInfo.auth }
      }, (res) => {
        let buf = ''
        res.setEncoding('utf8')
        res.on('data', (chunk) => {
          buf += chunk
          let idx
          while ((idx = buf.indexOf('\n\n')) >= 0) {
            const frame = buf.slice(0, idx)
            buf = buf.slice(idx + 2)
            const match = frame.match(/^data:\s*(.+)$/m)
            if (!match) continue
            let ev
            try { ev = JSON.parse(match[1].trim()) } catch(e) { continue }
            try { handleEvent(ev) } catch(e) {}
          }
        })
        const streamClosed = () => {
          if (streamEnded) return
          finish({ content: '', model: model, tokens: tokens })
        }
        res.on('end', streamClosed)
        res.on('close', streamClosed)
      })
      toolHeartbeat = setInterval(() => {
        if (streamEnded) {
          clearInterval(toolHeartbeat)
          return
        }
        const now = Date.now()
        for (const id in runningTools) {
          const tool = runningTools[id]
          if (now - tool.lastUpdate > 10000) {
            const elapsed = Math.floor((now - tool.started) / 1000)
            sendRef('◈ ' + tool.tool + ' running (' + elapsed + 's)', 'tool')
            tool.lastUpdate = now
          }
if (tool.lastOutput) emitOut(lastToolOut, id, tool.lastOutput, (d) => { sseChat(runId, { type: 'out', content: d }) })
    }
  }, 15000)
      const sendRef = (line, cls) => {
        sseChat(runId, { type: 'ref', content: line, cls: cls || '' })
      }

      const finish = (payload) => {
        if (streamEnded) return
        streamEnded = true
        delete runWatchdogs[runId]
        if (watchdog) clearTimeout(watchdog)
        if (aliveTimer) clearInterval(aliveTimer)
        if (toolHeartbeat) clearInterval(toolHeartbeat)
        try { es.destroy() } catch(e) {}
        sseChat(runId, Object.assign({ type: 'done', steps: stepCount }, payload || {}))
      }

      const fail = (msg) => {
        if (streamEnded) return
        streamEnded = true
        delete runWatchdogs[runId]
        if (watchdog) clearTimeout(watchdog)
        if (aliveTimer) clearInterval(aliveTimer)
        if (toolHeartbeat) clearInterval(toolHeartbeat)
        try { es.destroy() } catch(e) {}
        sseChat(runId, { type: 'error', content: msg })
      }

      es.on('error', (e) => {
        fail('SSE error: ' + e.message)
      })

      // v2 事件流: session.text.delta / session.reasoning.* / session.tool.* / session.step.* / session.usage.updated / session.execution.*
      const handleEvent = async (ev) => {
        const p = ev.data || ev.properties || {}
        const sid2 = p.sessionID || ev.sessionID
        if (sid2 && sessionId && sid2 !== sessionId) return
        if (ev.type === 'form.created' || ev.type === 'question.asked') {
          // v2.3.2: question 工具不再发 question.asked，而是 form.created + metadata.kind === 'question'
          const form = p.form || p
          const meta = form.metadata || {}
          if (ev.type === 'form.created' && meta.kind !== 'question') return
          let questions = form.questions || p.questions || []
          if ((!questions || !questions.length) && Array.isArray(form.fields)) {
            questions = form.fields.map((f, i) => ({
              key: f.key || ('q' + i),
              header: f.title || form.title || 'Question ' + (i + 1),
              question: f.description || f.title || '',
              options: Array.isArray(f.options) ? f.options.map((o) => ({
                label: o.label || o.value || String(o),
                value: o.value || o.label || String(o),
                description: o.description || ''
              })) : [],
              multiple: f.type === 'multiselect',
              custom: f.custom !== false
            }))
          }
          questions = (questions || []).map((q, i) => Object.assign({ key: q.key || ('q' + i) }, q))
          sseChat(runId, {
            type: 'question',
            data: {
              requestID: form.id || p.id || p.requestID,
              sessionID: form.sessionID || p.sessionID,
              questions: questions,
              tool: meta.tool || p.tool || null,
              form: ev.type === 'form.created'
            }
          })
          return
        }
        if (ev.type === 'form.replied' || ev.type === 'form.cancelled' || ev.type === 'question.replied' || ev.type === 'question.rejected') {
          sseChat(runId, { type: 'question_done', data: { requestID: p.id || p.requestID || p.formID } })
          return
        }
        if (ev.type === 'permission.asked' || ev.type === 'permission.v2.asked') {
          const permId = p.id || p.requestID
          if (permId) {
            const res = p.resources || p.patterns || []
            const resList = Array.isArray(res) ? res.map(String) : [String(res)]
            sendRef('🔒 permission · ' + (p.action || p.permission || 'request') + (resList.length ? ' · ' + resList.join(', ') : ''), 'permission')
            sseChat(runId, { type: 'permission', data: { requestID: permId, sessionID: p.sessionID, action: p.action || p.permission || '', resources: resList, metadata: p.metadata || null, source: p.source || null, legacy: false } })
          }
          return
        }
        if (ev.type === 'permission.replied' || ev.type === 'permission.v2.replied') {
          sseChat(runId, { type: 'permission_done', data: { requestID: p.requestID || p.id, reply: p.reply || '' } })
          return
        }
        if (ev.type === 'session.step.started') {
          stepCount++
          const mdl = p.model || {}
          if (mdl.id) {
            model = (mdl.providerID || 'opencode') + '/' + mdl.id
            if (!modelShown) {
              modelShown = true
              sendRef('> build · ' + model, 'info')
              if (!ctxLimit) {
                getCtxLimit(model).then((limit) => {
                  if (limit) ctxLimit = limit
                  pushCtx(0, ctxLimit)
                })
              }
            }
          }
          return
        }
        // v2 reasoning 事件的 ordinal 每条 assistant 消息从 0 重新计数，
        // key 必须拼上 assistantMessageID，否则第二步起不再显示 ✱/✓ 标识
        const reasonEvtKey = (pd) => { return (pd.assistantMessageID || pd.messageID || 'msg') + ':' + (pd.ordinal != null ? pd.ordinal : '0') }
        if (ev.type === 'session.reasoning.started') {
          reasonStart(reasonEvtKey(p))
          return
        }
        if (ev.type === 'session.reasoning.delta') {
          reasonStart(reasonEvtKey(p))
          if (p.delta) sseChat(runId, { type: 'text', content: p.delta, cls: 'reasoning' })
          return
        }
        if (ev.type === 'session.reasoning.ended') {
          reasonDone(reasonEvtKey(p))
          return
        }
        // v2 的 reasoning.ended 在正文/工具调用开始后才发（甚至可能不来），
        // 正文一开流即视为本条消息的 reasoning 全部结束，保证 ✓ 标识位置正确
        if (ev.type === 'session.text.started') {
          const pre = (p.assistantMessageID || p.messageID || 'msg') + ':'
          for (const k in reasoningSeen) {
            if (k.indexOf(pre) === 0 && reasoningSeen[k] !== 'done') {
              reasoningSeen[k] = 'done'
              sendRef('✓ reasoning done', 'reasoning')
            }
          }
          return
        }
        if (ev.type === 'session.text.delta') {
          if (p.delta) sseChat(runId, { type: 'text', content: p.delta })
          return
        }
        if (ev.type === 'session.tool.input.started') {
          const callId = p.id || ('tool#' + (++toolSeq))
          runningTools[callId] = { tool: p.name || 'tool', arg: '', started: Date.now(), lastUpdate: Date.now() }
          // 工具开始也视为 reasoning 结束（工具调用前 reasoning.ended 可能还未到）
          const pre = (p.assistantMessageID || p.messageID || 'msg') + ':'
          for (const k in reasoningSeen) {
            if (k.indexOf(pre) === 0 && reasoningSeen[k] !== 'done') {
              reasoningSeen[k] = 'done'
              sendRef('✓ reasoning done', 'reasoning')
            }
          }
          return
        }
        if (ev.type === 'session.tool.input.ended') {
          const callId = p.id || ('tool#' + toolSeq)
          let inp = {}
          try { inp = JSON.parse(p.text || '{}') } catch(e) {}
          const rt = runningTools[callId]
          const arg = toolArg(inp)
          if (rt) { rt.arg = arg; rt.lastUpdate = Date.now() }
          if (!seenTools[callId]) {
            seenTools[callId] = true
            sendRef('◈ ' + ((rt && rt.tool) || 'tool') + (arg ? ' · ' + maskSecrets(arg) : ''), 'tool')
          }
          return
        }
        if (ev.type === 'session.tool.called' || ev.type === 'session.tool.progress') {
          const callId = p.id || ('tool#' + toolSeq)
          const rt = runningTools[callId]
          if (rt) rt.lastUpdate = Date.now()
          if (ev.type === 'session.tool.called' && p.input) {
            const arg = toolArg(p.input)
            if (rt && !rt.arg) rt.arg = arg
            if (!seenTools[callId]) {
              seenTools[callId] = true
              sendRef('◈ ' + ((rt && rt.tool) || 'tool') + (arg ? ' · ' + maskSecrets(arg) : ''), 'tool')
            }
          }
          return
        }
        if (ev.type === 'session.tool.success' || ev.type === 'session.tool.error') {
          const callId = p.id || ('tool#' + toolSeq)
          const rt = runningTools[callId]
          const toolName = (rt && rt.tool) || 'tool'
          delete runningTools[callId]
          if (ev.type === 'session.tool.success') {
            if (!seenTools[callId]) {
              seenTools[callId] = true
              sendRef('◈ ' + toolName + (rt && rt.arg ? ' · ' + maskSecrets(rt.arg) : ''), 'tool')
            }
            // 先推工具内容再收尾，保证 ✓ done 在输出之后
            const out = toolOut(p.content)
            if (out) emitOut(lastToolOut, callId, out, (d) => { sseChat(runId, { type: 'out', content: d }) })
            sendRef('✓ ' + toolName + ' done', 'tool')
          } else {
            const out = toolOut(p.content || p.error)
            if (out) emitOut(lastToolOut, callId, out, (d) => { sseChat(runId, { type: 'out', content: d }) })
            sendRef('✗ ' + toolName + ' failed', 'tool')
          }
          return
        }
        if (ev.type === 'session.usage.updated') {
          // 这里的 tokens 来自 session 表的累计值（projector 对每个 step 做 +=），
          // 是整段会话历史的总用量，不是当前上下文大小，不能用于 ctx 或消息结尾的 tokens。
          // ctx 只取 session.step.ended 的单步 tokens 和 compact 的摘要 tokens。
          return
        }
        if (ev.type === 'session.step.ended') {
          if (p.tokens) {
            tokens = p.tokens
            const used = tokenTotal(p.tokens)
            if (used) emitCtx(used)
          }
          return
        }
        if (ev.type === 'session.execution.succeeded') {
          finish({ content: '', model: model, tokens: tokens })
          return
        }
        if (ev.type === 'session.execution.failed' || ev.type === 'session.error') {
          const errObj = p.error || p
          const errMsg = (typeof errObj === 'string' ? errObj : (errObj.message || errObj.name || 'session error'))
          fail(String(errMsg).split('\n')[0])
          return
        }
        if (ev.type === 'session.renamed') {
          return
        }
        if (ev.type === 'session.compaction.started') {
          sendRef('✂ context compacting…', 'info')
          return
        }
        if (ev.type === 'session.compaction.delta') {
          // 压缩摘要流式输出（字段为 text）
          if (p.text) sseChat(runId, { type: 'text', content: p.text, cls: 'compact' })
          return
        }
        if (ev.type === 'session.compaction.ended') {
          const mdl = p.model || {}
          if (mdl.id) model = (mdl.providerID || 'opencode') + '/' + mdl.id
          // ended 事件 tokens：input+cache = 压缩前，output+reasoning = 压缩后摘要。
          // ✂ 行显示 before → after；footer 只记压缩后摘要大小，与其他消息的“单条用量”口径一致。
          const after = compactAfter(p.tokens)
          sendRef(compactRef(p.tokens), 'info')
          if (after) emitCtx(after)
          tokens = after ? { output: after } : null
          finish({ content: '', model: model, tokens: tokens })
          return
        }
        if (ev.type === 'todo.updated' || ev.type === 'session.todo.updated') {
          sseChat(runId, { type: 'todo', data: p.todos || [] })
          return
        }
      }

      if (/^\//.test(prompt)) {
        runWatchdogs[runId].kick()
        const cmdLine = prompt.trim().slice(1)
        const cmdSpace = cmdLine.indexOf(' ')
        const cmdName = (cmdSpace >= 0 ? cmdLine.slice(0, cmdSpace) : cmdLine).toLowerCase()
        const cmdArgs = cmdSpace >= 0 ? cmdLine.slice(cmdSpace + 1).trim() : ''
        try {
          if (cmdName === 'compact' || cmdName === 'summarize') {
            // v2: 专有端点 POST /api/session/<id>/compact，异步执行，
            // 完成后由 SSE 的 session.compaction.started/ended 结束本次流
            const sum = await api('POST', '/session/' + sessionId + '/compact', {})
            if (sum.status !== 200) {
              fail('compact failed: ' + sum.body.slice(0, 120))
            } else {
              // 进度提示由 SSE 的 session.compaction.started/ended 事件发出，这里只续期 watchdog
              runWatchdogs[runId].kick()
            }
          } else if (cmdName === 'undo' || cmdName === 'redo') {
            const msgs = await api('GET', '/session/' + sessionId + '/message?limit=2')
            let arr = []
            try { arr = JSON.parse(msgs.body); if (arr && arr.data) arr = arr.data } catch(e) {}
            let target = null
            for (let mi = arr.length - 1; mi >= 0; mi--) {
              const minf = arr[mi].info || arr[mi] || {}
              if (minf.role === 'user') { target = minf.id; break }
            }
            if (!target) {
              fail('no message to ' + cmdName)
            } else {
              const rev = await api('POST', '/session/' + sessionId + '/' + (cmdName === 'undo' ? 'revert' : 'unrevert'), { messageID: target })
              if (rev.status !== 200) {
                fail(cmdName + ' failed: ' + rev.body.slice(0, 120))
              } else {
                sendRef(cmdName + ' ' + target.slice(0, 8), 'info')
                finish({ content: '', model: model, tokens: tokens })
              }
            }
          } else {
            api('POST', '/session/' + sessionId + '/command', { command: cmdName, arguments: cmdArgs, agent: 'build' }).then((r) => {
              if (streamEnded) return
              if (r.status >= 400) fail('/' + cmdName + ' failed: ' + r.body.slice(0, 120))
            }).catch((e) => {
              if (!streamEnded) fail('/' + cmdName + ' error: ' + e.message)
            })
          }
        } catch(e) {
          fail(e.message || String(e))
        }
        return
      }

      // v2: prompt 为 { text, model? }（parts 结构已废弃），POST 后同步返回用户消息
      const body = { text: prompt }
      if (data.model) {
        const m = data.model.replace(/\r/g, '')
        const slash = m.indexOf('/')
        if (slash > 0) body.model = { providerID: m.slice(0, slash), modelID: m.slice(slash + 1) }
      }
      const sent = await api('POST', '/session/' + sessionId + '/prompt', body)
      if (sent.status === 404) {
        fail('session not found: ' + sessionId)
        return
      }
      runWatchdogs[runId].kick()
      aliveTimer = setInterval(() => {
        try {
          if (typeof $ws.sseExists !== 'function' || $ws.sseExists('opencode-main')) return
          clearInterval(aliveTimer)
          aliveTimer = null
          const ab = (svcUrl && svcUrl.protocol === 'https:' ? require('https') : httpMod).request({
            hostname: svcBase.hostname, port: svcBase.port,
            path: '/api/session/' + encodeURIComponent(sessionId) + '/interrupt',
            method: 'POST', headers: { 'Authorization': svcInfo.auth }
          }, (r) => {
            r.resume()
            r.on('end', () => { fail('client disconnected') })
          })
          ab.on('error', () => { fail('client disconnected') })
          ab.end()
        } catch(e) {}
      }, 15000)
    } catch(e) {
      fail(e.message || String(e))
    }
    })()
  }

  return (async () => {
    let sessionId = data.session || ''
    try {
      const title = String(prompt || '').replace(/\s+/g, ' ').trim().slice(0, 60)
      if (!sessionId) {
        const created = await api('POST', '/session', { title: title })
        if (created.status !== 200) throw new Error('create session failed: ' + created.body.slice(0, 120))
        const createdObj = JSON.parse(created.body)
        sessionId = (createdObj.data || createdObj).id
      } else if (title) {
        api('GET', '/session/' + sessionId).then((got) => {
          let cur = ''
          try { const jo = JSON.parse(got.body); cur = ((jo.data || jo) || {}).title || '' } catch(e) {}
          if (!cur) api('PATCH', '/session/' + sessionId, { title: title })
        }).catch(() => {})
      }
      // 新建/改标题后会话列表变化，立即失效缓存让下拉列表尽快显示新 title
      try { $store.set('aichat_oc_sessions_cache', '') } catch(e) {}
      try { $store.set('aichat_oc_sessions_time', '0') } catch(e) {}
      streamRun(sessionId)
      return { ok: true, runId: runId, sessionId: sessionId }
    } catch(e) {
      return { ok: false, error: e.message || String(e) }
    }
  })()
})

$fend('commands', async (data) => {
  const out = [
    { name: 'compact', description: 'compact the current conversation (via summarize)' },
    { name: 'new', description: 'start a new session' },
    { name: 'undo', description: 'undo last message' },
    { name: 'redo', description: 'redo last undone message' }
  ]
  try {
    let list = await apiGet('/command')
    if (list && list.data) list = list.data
    if (Array.isArray(list)) {
      for (let i = list.length - 1; i >= 0; i--) {
        out.unshift({ name: list[i].name || '', description: list[i].description || '' })
      }
    }
  } catch(e) {}
  return { ok: true, commands: out }
})

$fend('stop', async (data) => {
  if (!data) return { ok: false }
  const runId = data.runId
  const sessionId = data.session || ''
  const rp = runProcs[runId] || $cache.get('oc_run_' + runId)
  if (rp) {
    try {
      if (IS_WIN) await execAsync('taskkill /PID ' + rp.pid + ' /T /F', 5000)
      else rp.kill('SIGTERM')
    } catch(e) {
      try { rp.kill() } catch(e2) {}
    }
    try { delete runProcs[runId] } catch(e) {}
    try { $cache.delete('oc_run_' + runId) } catch(e) {}
    return { ok: true, mode: 'run' }
  }
  try {
    if (!sessionId) return { ok: false, error: 'no active session' }
    // v2: 停止接口为 POST /api/session/<id>/interrupt
    await apiPost('/session/' + encodeURIComponent(sessionId) + '/interrupt', {})
    return { ok: true, mode: 'serve' }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

const isOcV2 = (version) => {
  const major = parseInt(String(version || '').replace(/^v/i, ''), 10)
  // 解析不出来时不强制重装，避免 dev/特殊版本号反复触发安装
  return isNaN(major) || major >= 2
}

const resolveOcVersion = (tries) => {
  return new Promise((resolve) => {
    const attempt = (n) => {
      execAsync(redirCmd(OC_BIN + ' --version'), 20000).then((v) => {
        const version = v.stdout.trim().replace(/^opencode\s*/i, '')
        if (version) resolve({ ok: true, version: version })
        else if (n > 1) setTimeout(() => { attempt(n - 1) }, 1000)
        else resolve({ ok: false, error: new Error('empty version output') })
      }).catch((e) => {
        if (n > 1) setTimeout(() => { attempt(n - 1) }, 1000)
        else resolve({ ok: false, error: e })
      })
    }
    attempt(tries || 2)
  })
}

// 安装进度统一走 opencode-main 通道（消息带 install: true 标记），不再另开随机 SSE 通道
$fend('ensure_opencode', async (data) => {
  const r = await resolveOcVersion(2)
  if (r.ok && isOcV2(r.version)) {
    const version = r.version
    console.log('[ensure_opencode] version:', version)
    return { ok: true, installing: false, version: version }
  }
  if (r.ok) console.log('[ensure_opencode] v1 detected, upgrading to v2:', r.version)
  const ssePush = (obj) => { try { $ws.sse('opencode-main', JSON.stringify(Object.assign({ install: true }, obj))) } catch(e) {} }
  try {
    const freeMem = require('os').freemem()
    const freeMB = Math.round(freeMem / 1024 / 1024)
    if (freeMem < 1024 * 1024 * 1024) {
      const msg = '当前可用内存 ' + freeMB + 'M，内存过小，opencode 无法使用'
      console.log('[ensure_opencode] memory too low:', freeMB + 'M')
      ssePush({ type: 'error', content: msg })
      return { ok: false, error: msg }
    }
    // v1 的 npm 包是 opencode-ai，v2 是 @opencode/cli；两者共用 opencode 命令，必须先卸载 v1
    const uninstallCmd = 'npm uninstall -g opencode-ai'
    const installCmd = 'npm install -g @opencode/cli@latest --loglevel=verbose'
    const INSTALL_CMD = process.platform === 'win32'
      ? uninstallCmd + ' & ' + installCmd
      : uninstallCmd + ' >/dev/null 2>&1; ' + installCmd
    ssePush({ type: 'cmd', content: INSTALL_CMD })
    const proc = spawn(process.platform === 'win32' ? process.env.COMSPEC : 'sh',
      process.platform === 'win32' ? ['/d', '/s', '/c', INSTALL_CMD + ' 2>&1'] : ['-c', INSTALL_CMD + ' 2>&1'],
      { timeout: 120000, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] })
    const fullLog = []
    const sendProgress = (text) => {
      const lines = stripAnsi(text.toString()).split('\n').filter(Boolean)
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim()
        console.log('[npm install]', line)
        if (line) {
          fullLog.push(line)
          if (fullLog.length > 2000) fullLog.splice(0, fullLog.length - 2000)
          ssePush({ type: 'progress', content: line })
        }
      }
    }
    proc.stdout.on('data', sendProgress)
    proc.stderr.on('data', sendProgress)
    proc.on('close', async (code) => {
      try {
        if (code === 0) {
          const vr = await resolveOcVersion(3)
          const version = vr.ok ? vr.version : 'unknown'
          console.log('[npm install] done, version:', version)
          if (!vr.ok) console.log('[npm install] version check failed:', vr.error && vr.error.message)
          ssePush({ type: 'full_log', content: fullLog.join('\n') })
          if (!vr.ok || !isOcV2(version)) {
            ssePush({ type: 'error', content: 'Installed opencode is not v2 (version: ' + version + ')' })
            return
          }
          ssePush({ type: 'done', version: version })
        } else {
          ssePush({ type: 'full_log', content: fullLog.join('\n') })
          ssePush({ type: 'error', content: 'npm install failed (code ' + code + ')' })
        }
      } catch(e) {
        ssePush({ type: 'full_log', content: fullLog.join('\n') })
        ssePush({ type: 'error', content: e.message })
      }
    })
    proc.on('error', (e) => {
      ssePush({ type: 'full_log', content: fullLog.join('\n') })
      ssePush({ type: 'error', content: e.message })
    })
    return { ok: true, installing: true }
  } catch(e) {
    ssePush({ type: 'error', content: e.message })
    return { ok: true, installing: true }
  }
})

$fend('models', async (data) => {
  const force = data && data.force
  const now = Date.now()
  let cached, cachedTime
  try { cached = JSON.parse($store.get('aichat_models_cache') || 'null') } catch(e) {}
  try { cachedTime = Number($store.get('aichat_models_time') || 0) } catch(e) {}
  if (!force && cached && now - cachedTime < 60000) return { models: cached, cached: true }
  const parseList = (raw) => {
    if (!raw) return []
    const out = []
    String(raw).split('\n').forEach((s) => {
      const c = stripAnsi(s).trim()
      if (!c || /^models cache refreshed$/i.test(c) || c.charAt(0) === '#') return
      if (out.indexOf(c) < 0) out.push(c)
    })
    return out
  }
  const runList = async (opt) => {
    const r = await execAsync(redirCmd(OC_BIN + ' models' + (opt && opt.refresh ? ' --refresh' : '')), opt && opt.refresh ? 20000 : 10000)
    return r.stdout
  }
  try {
    const raw = await runList(force ? { refresh: true } : {})
    console.log('[models]' + (force ? ' force-refresh' : '') + ' raw:', stripAnsi(raw).trim())
    const list = parseList(raw)
    if (list.length) {
      $store.set('aichat_models_cache', JSON.stringify(list))
      $store.set('aichat_models_time', String(Date.now()))
      return { models: list }
    }
  } catch(e) {
    console.log('[models] exec error:', e.message)
  }
  return { models: cached || [] }
})

$fend('sessions', () => {
  try {
    const raw = $store.get('aichat_sessions') || '[]'
    const local = JSON.parse(raw)
    const raw2 = $store.get('aichat_pinned_sessions') || '[]'
    const pinned = JSON.parse(raw2)
    return { sessions: local, pinned: pinned }
  } catch(e) {
    return { sessions: [], pinned: [] }
  }
})

$fend('delete_session', (data) => {
  if (!data || !data.id) return { ok: false }
  try {
    const raw = $store.get('aichat_sessions') || '[]'
    let list = JSON.parse(raw)
    list = list.filter((s) => { return s.id !== data.id })
    $store.set('aichat_sessions', JSON.stringify(list))
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('opencode_sessions', async () => {
  const now = Date.now()
  let cached, cachedTime
  try { cached = JSON.parse($store.get('aichat_oc_sessions_cache') || 'null') } catch(e) {}
  try { cachedTime = Number($store.get('aichat_oc_sessions_time') || 0) } catch(e) {}

  if (cached && now - cachedTime < 15000) return { sessions: cached, cached: true }
  let svc = { url: '', auth: '' }
  try { svc = await getServiceInfo() } catch(e) {}
  if (!svc.url) {
    svc.url = 'http://127.0.0.1:49374'
    try {
      const fs = require('fs')
      const svcCfg = JSON.parse(fs.readFileSync(require('os').homedir() + '/.config/opencode/service.json', 'utf8'))
      const pwd = svcCfg.password
      if (pwd) svc.auth = 'Basic ' + Buffer.from('opencode:' + pwd).toString('base64')
    } catch(e) {}
  }
  const url = new URL(svc.url)
  const httpMod = url.protocol === 'https:' ? require('https') : require('http')
  const opts = {
    hostname: url.hostname,
    port: url.port || (url.protocol === 'https:' ? 443 : 80),
    path: '/api/session',
    method: 'GET',
    headers: { 'Authorization': svc.auth }
  }
  const sessions = await new Promise((resolve) => {
    const req = httpMod.request(opts, (res) => {
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => {
        try {
          const parsed = JSON.parse(buf)
          const list = Array.isArray(parsed.data) ? parsed.data : []
          list.forEach((s) => {
            if (s.time) {
              if (!s.updated && s.time.updated) s.updated = s.time.updated
              if (!s.created && s.time.created) s.created = s.time.created
            }
          })
          resolve(list)
        } catch(e) { resolve(null) }
      })
    })
    req.on('error', () => resolve(null))
    req.setTimeout(8000, () => { req.destroy(); resolve(null) })
    req.end()
  })
  if (sessions) {
    $store.set('aichat_oc_sessions_cache', JSON.stringify(sessions))
    $store.set('aichat_oc_sessions_time', String(Date.now()))
    return { sessions: sessions }
  }
  if (cached) return { sessions: cached }
  return { sessions: [] }
})

$fend('opencode_delete_session', async (data) => {
  if (!data || !data.id) return { ok: false }
  try {
    await execAsync(redirCmd(OC_BIN + ' session delete ' + data.id), 10000)
  } catch(e) {
    return { ok: false, error: e.message }
  }
  try {
    let cache = []
    try { cache = JSON.parse($store.get('aichat_oc_sessions_cache') || '[]') } catch(e) {}
    if (Array.isArray(cache)) {
      $store.set('aichat_oc_sessions_cache', JSON.stringify(cache.filter((s) => { return s && s.id !== data.id })))
    }
  } catch(e2) {}
  return { ok: true }
})

// v2: 动态服务地址 + Basic Auth，路径自动加 /api 前缀
const ocRequest = async (method, path, body) => {
  const httpMod = require('http')
  const svc = await getServiceInfo()
  const url = svc.url ? new URL(svc.url) : new URL('http://127.0.0.1')
  const payload = body ? JSON.stringify(body) : ''
  return new Promise((resolve, reject) => {
    const req = (url.protocol === 'https:' ? require('https') : httpMod).request({
      hostname: url.hostname,
      port: url.port || (url.protocol === 'https:' ? 443 : 80),
      path: '/api' + path, method: method,
      headers: Object.assign({ 'Authorization': svc.auth }, body ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) } : {})
    }, (res) => {
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => { resolve({ status: res.statusCode, body: buf }) })
    })
    req.on('error', reject)
    req.setTimeout(8000, () => { req.destroy(); reject(new Error('timeout')) })
    if (body) req.write(payload)
    req.end()
  })
}
const ocPost = (path, body) => ocRequest('POST', path, body)

// v2: 动态服务地址 + Basic Auth（保留供未迁移的 v1 端点调用方使用，路径不加前缀）
const httpPut = async (path, body) => {
  const httpMod = require('http')
  const svc = await getServiceInfo()
  const url = svc.url ? new URL(svc.url) : new URL('http://127.0.0.1')
  const payload = body ? JSON.stringify(body) : ''
  return new Promise((resolve) => {
    const req = (url.protocol === 'https:' ? require('https') : httpMod).request({
      hostname: url.hostname,
      port: url.port || (url.protocol === 'https:' ? 443 : 80),
      path: path, method: 'PUT',
      headers: Object.assign({ 'Authorization': svc.auth }, body ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) } : {})
    }, (res) => {
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => { resolve({ status: res.statusCode, body: buf }) })
    })
    req.on('error', (e) => { resolve({ status: 0, body: '', error: e.message }) })
    req.setTimeout(8000, () => { req.destroy(); resolve({ status: 0, body: '', error: 'timeout' }) })
    if (body) req.write(payload)
    req.end()
  })
}

const LOGIN_FALLBACK_PROVIDERS = [
  { id: 'opencode', name: 'OpenCode Zen', hint: 'token from opencode.ai/auth — free models available (big-pickle etc.)' },
  { id: 'openai', name: 'OpenAI', hint: 'platform.openai.com/api-keys' },
  { id: 'anthropic', name: 'Anthropic', hint: 'console.anthropic.com' },
  { id: 'google', name: 'Google Gemini', hint: 'aistudio.google.com/apikey' },
  { id: 'openrouter', name: 'OpenRouter', hint: 'openrouter.ai/keys' },
  { id: 'deepseek', name: 'DeepSeek', hint: '' },
  { id: 'groq', name: 'Groq', hint: 'console.groq.com/keys' },
  { id: 'xai', name: 'xAI (Grok)', hint: 'console.x.ai' },
  { id: 'mistral', name: 'Mistral', hint: '' },
  { id: 'togetherai', name: 'Together AI', hint: '' },
  { id: 'zhipuai', name: 'Zhipu AI (GLM)', hint: '' },
  { id: 'moonshotai', name: 'Moonshot (Kimi)', hint: '' },
  { id: 'minimax', name: 'MiniMax', hint: '' }
]

$fend('login_check', async () => {
  let up = false
  try { up = await ensureServer() } catch(e) {}
  if (!up) {
    return { ok: true, possible: true, serverDown: true, connected: [], providers: LOGIN_FALLBACK_PROVIDERS.slice() }
  }
  // v2: GET /api/provider 返回 { data: [...] }（integration 列表）；无独立的 connected 字段
  const list = []
  let connected = []
  try {
    const provs = await apiGet('/provider')
    const parr = (provs && provs.data) ? provs.data : (Array.isArray(provs) ? provs : [])
    for (const p of parr) {
      if (p && p.id) list.push({ id: p.id, name: p.name || p.id, hint: '' })
    }
  } catch(e) {}
  try {
    const integ = await apiGet('/integration')
    const iarr = (integ && integ.data) ? integ.data : (Array.isArray(integ) ? integ : [])
    for (const ig of iarr) {
      const conns = ig && ig.connections
      if (Array.isArray(conns) && conns.length && ig.id && !connected.includes(ig.id)) connected.push(ig.id)
    }
  } catch(e) {}
  for (const f of LOGIN_FALLBACK_PROVIDERS) {
    if (!list.some((x) => x.id === f.id)) list.push(f)
  }
  return { ok: true, possible: true, serverDown: false, connected: connected, providers: list }
})

$fend('login_apikey', async (data) => {
  const provider = data && data.provider ? String(data.provider).trim() : ''
  const key = data && data.key ? String(data.key).trim() : ''
  if (!provider) return { ok: false, error: 'provider is empty' }
  if (!key) return { ok: false, error: 'API key is empty' }
  // v2: 无 PUT /api/auth HTTP 端点，改走 CLI `opencode auth login <provider> --method key --answer key=<key>`
  try {
    await execAsync(OC_BIN + ' auth login ' + provider + ' --method key --answer key=' + key.replace(/["'\\]/g, ''), 30000)
    console.log('[login_apikey] provider', provider, 'saved')
    return { ok: true, provider: provider }
  } catch(e) {
    const errText = stripAnsi((e && (e.stderr || e.message)) || String(e)).split('\n')[0].slice(0, 200)
    return { ok: false, error: 'login failed: ' + errText }
  }
})

$fend('question_reply', async (data) => {
  if (!data || !data.requestID) return { ok: false, error: 'invalid params' }
  try {
    let r
    if (data.form) {
      // v2: question 走 form 端点，answer 是按字段 key 索引的对象
      if (!data.sessionID) return { ok: false, error: 'sessionID is empty' }
      const answer = (data.formAnswers && typeof data.formAnswers === 'object') ? data.formAnswers : {}
      const path = '/session/' + encodeURIComponent(data.sessionID) + '/form/' + encodeURIComponent(data.requestID) + '/reply'
      r = await ocRequest('POST', path, { answer: answer })
    } else {
      if (!Array.isArray(data.answers)) return { ok: false, error: 'invalid params' }
      r = await ocPost('/question/' + encodeURIComponent(data.requestID) + '/reply', { answers: data.answers })
    }
    if (r.status < 200 || r.status >= 300) return { ok: false, error: r.body.slice(0, 200) }
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('question_reject', async (data) => {
  if (!data || !data.requestID) return { ok: false, error: 'invalid params' }
  try {
    let r
    if (data.form) {
      // v2: 取消 form（success 是 204 No Content）
      if (!data.sessionID) return { ok: false, error: 'sessionID is empty' }
      const path = '/session/' + encodeURIComponent(data.sessionID) + '/form/' + encodeURIComponent(data.requestID)
      r = await ocRequest('DELETE', path)
    } else {
      r = await ocPost('/question/' + encodeURIComponent(data.requestID) + '/reject')
    }
    if (r.status < 200 || r.status >= 300) return { ok: false, error: r.body.slice(0, 200) }
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('permission_reply', async (data) => {
  if (!data || !data.requestID) return { ok: false, error: 'invalid params' }
  const reply = ['once', 'always', 'reject'].indexOf(data.reply) >= 0 ? data.reply : ''
  if (!reply) return { ok: false, error: 'invalid reply' }
  try {
    // ocPost 会自动加 /api 前缀
    const path = '/session/' + encodeURIComponent(data.sessionID || '') + '/permission/' + encodeURIComponent(data.requestID) + '/reply'
    const r = await ocPost(path, { reply: reply, message: data.message || '' })
    if (r.status !== 200) return { ok: false, error: r.body.slice(0, 200) }
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})
</script>

